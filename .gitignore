/target
# Cargo.lock IS tracked: melange-cli ships a binary, so the lockfile is committed
# for reproducible builds and a stable MSRV floor. (A library would gitignore it.)
# The nightly-only fuzz crate is workspace-excluded; its separate lock stays local.
crates/melange-solver/fuzz/Cargo.lock
*.swp
*.swo
*~
.DS_Store
.venv/
__pycache__/
*.pyc
.claude/
test.rs
test_output.txt
out

# Audio files
*.wav

# DAW peak cache (Reaper)
peaks/

# ngspice source distribution
ngspice*/
ngspice_*
# ...but keep the checked-in ngspice golden-reference regen kit (the ngspice_*
# rule above would otherwise eat this directory and break golden reproducibility).
!crates/melange-solver/tests/golden/ngspice_ref/

# Package archives
*.tar.gz
*.tar.xz
*.dsc

# Generated reports
*.html

# Archived/disabled files (git history preserves them)
*.archived
*.disabled
golden-baselines/

# Local, machine-specific melange context (ecosystem, inter-agent mail) — not public
CLAUDE.local.md

# Local, untracked working docs (design notes, briefs, research) — not public
local-docs/
