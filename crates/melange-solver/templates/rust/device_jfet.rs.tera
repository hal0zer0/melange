// Canonical source: melange-devices/src/jfet.rs (Jfet)
// Duplicated here because generated code must be self-contained.
// 2D Shichman-Hodges model: triode + saturation regions, with channel-length modulation.
// Dimension 0: Id (drain current), Dimension 1: Ig (gate current through the
// gate-source and gate-drain junctions, see jfet_evaluate).
//
// SPICE-style mode handling: for vds_eff >= 0 (normal mode) the source-referenced
// overdrive Vgs - Vp governs. For vds_eff < 0 (reverse mode) the drain acts as the
// source, so the drain-referenced overdrive Vgd - Vp governs: the normal-mode
// equations are evaluated at (vgd, -vds) and the result is negated. The triode
// expression is exactly symmetric under this swap, so value and all Jacobian
// entries are continuous across Vds = 0. Channel-length modulation uses the
// mode-consistent |Vds| (SPICE behavior).

/// JFET drain current (Shichman-Hodges 2D model).
/// sign: +1.0 for N-channel, -1.0 for P-channel
#[inline(always)]
fn jfet_id(vgs: f64, vds: f64, idss: f64, vp: f64, lambda: f64, sign: f64) -> f64 {
    let vgs_eff = sign * vgs;
    let vds_eff = sign * vds;
    let vp_eff = sign * vp; // Always negative after sign application
    // Mode selection: vc = controlling gate reference, vd = |vds_eff|,
    // m = polarity of the drain current.
    let (vc, vd, m) = if vds_eff >= 0.0 {
        (vgs_eff, vds_eff, 1.0)
    } else {
        // Reverse mode: drain acts as source. vgd_eff = vgs_eff - vds_eff.
        (vgs_eff - vds_eff, -vds_eff, -1.0)
    };
    let vgst = vc - vp_eff;
    if vgst <= 0.0 {
        // Subthreshold: weak exponential for smooth NR convergence.
        // Gated by tanh(vd/2VT) so the leakage is continuous (and zero)
        // at Vds = 0 where the mode polarity m flips sign.
        let sub = 1e-12 * fast_exp(vgst / (2.0 * 0.025864925786328753)).min(1.0);
        return sign * m * sub * (vd / (2.0 * 0.025864925786328753)).tanh();
    }
    let vp_abs = vp.abs();
    let vds_sat = vgst;
    // Channel-length modulation uses the mode-consistent |Vds|.
    let clm = 1.0 + lambda * vd;
    if vd < vds_sat {
        // Triode region: Id = IDSS/Vp^2 * (2*Vgst*Vds - Vds^2) * (1 + lambda*|Vds|)
        let id = idss / (vp_abs * vp_abs) * (2.0 * vgst * vd - vd * vd);
        sign * m * id * clm
    } else {
        // Saturation region: Id = IDSS * (Vgst/|Vp|)^2 * (1 + lambda*|Vds|)
        let ratio = vgst / vp_abs;
        sign * m * idss * ratio * ratio * clm
    }
}

/// JFET 2x2 Jacobian: [dId/dVgs, dId/dVds, dIg/dVgs, dIg/dVds]
#[inline(always)]
fn jfet_jacobian(vgs: f64, vds: f64, idss: f64, vp: f64, lambda: f64, sign: f64) -> [f64; 4] {
    let vgs_eff = sign * vgs;
    let vds_eff = sign * vds;
    let vp_eff = sign * vp;
    // Mode selection — must mirror jfet_id exactly.
    // Id = sign * m * f(vc, vd), with:
    //   normal  (m=+1): vc = vgs_eff,           vd = vds_eff
    //   reverse (m=-1): vc = vgs_eff - vds_eff, vd = -vds_eff
    // Chain rule to external (vgs, vds), with sign^2 = 1:
    //   normal:  dId/dVgs = f_c            dId/dVds = f_d
    //   reverse: dId/dVgs = -f_c           dId/dVds = f_c + f_d
    let (vc, vd, m) = if vds_eff >= 0.0 {
        (vgs_eff, vds_eff, 1.0)
    } else {
        (vgs_eff - vds_eff, -vds_eff, -1.0)
    };
    let vgst = vc - vp_eff;

    // (f_c, f_d) = (df/dvc, df/dvd)
    let (f_c, f_d) = if vgst <= 0.0 {
        // Subthreshold: derivative of tanh-gated weak exponential
        let sub = 1e-12 * fast_exp(vgst / (2.0 * 0.025864925786328753)).min(1.0);
        let t = (vd / (2.0 * 0.025864925786328753)).tanh();
        (
            sub * t / (2.0 * 0.025864925786328753),
            sub * (1.0 - t * t) / (2.0 * 0.025864925786328753),
        )
    } else {
        let vp_abs = vp.abs();
        let vp2 = vp_abs * vp_abs;
        let vds_sat = vgst;
        let clm = 1.0 + lambda * vd;
        if vd < vds_sat {
            // Triode region
            let f_c = idss * 2.0 * vd / vp2 * clm;
            let f_d_base = idss / vp2 * (2.0 * vgst - 2.0 * vd);
            let f_d_lambda = idss / vp2 * (2.0 * vgst * vd - vd * vd) * lambda;
            (f_c, f_d_base * clm + f_d_lambda)
        } else {
            // Saturation region
            let ratio = vgst / vp_abs;
            let f_c = idss * 2.0 * vgst / vp2 * clm;
            let f_d = idss * ratio * ratio * lambda;
            (f_c, f_d)
        }
    };

    let (d_id_d_vgs, d_id_d_vds) = if m >= 0.0 {
        (f_c, f_d)
    } else {
        (-f_c, f_c + f_d)
    };

    // Gate current derivatives are zero (no gate leakage in this model)
    [d_id_d_vgs, d_id_d_vds, 0.0, 0.0]
}

/// JFET terminal currents and Jacobian, channel plus both gate junctions:
/// `(I_drain, I_gate, [dId/dVgs, dId/dVds, dIg/dVgs, dIg/dVds])`.
/// Gate junctions `IS·(exp(V/n_vt) − 1)` at Vgs and Vgd = Vgs − Vds in the
/// device's polarity; the drain loses the gate-drain junction's current.
/// `is = 0` disables them. Canonical: melange-devices `Jfet::evaluate`.
#[inline(always)]
fn jfet_evaluate(vgs: f64, vds: f64, idss: f64, vp: f64, lambda: f64, is: f64, n_vt: f64,
                 sign: f64) -> (f64, f64, [f64; 4]) {
    let id = jfet_id(vgs, vds, idss, vp, lambda, sign);
    let jac = jfet_jacobian(vgs, vds, idss, vp, lambda, sign);
    if is == 0.0 {
        return (id, 0.0, jac);
    }
    let (e_gs, de_gs) = junction_exp(sign * vgs / n_vt, is);
    let (e_gd, de_gd) = junction_exp(sign * (vgs - vds) / n_vt, is);
    let i_gs = sign * is * (e_gs - 1.0);
    let i_gd = sign * is * (e_gd - 1.0);
    let g_gs = is / n_vt * de_gs;
    let g_gd = is / n_vt * de_gd;
    (id - i_gd, i_gs + i_gd, [jac[0] - g_gd, jac[1] + g_gd, g_gs + g_gd, -g_gd])
}
