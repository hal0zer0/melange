// Glow-discharge / neon lamp helpers. Two independently-gated fns:
//   * glow_lit_eval  — RELAXING lit-branch inner Newton (emitted when a glow
//                      device carries active sections; `emit_lit_eval`)
//   * glow_D         — ignition-depression curve D(t_off) (emitted when a glow
//                      device has D_AMP≠0; `emit_d`)
// A no-section-no-D glow deck sees NEITHER helper (byte-identical to today).
{% if emit_lit_eval %}
// --- Relaxing lit branch (Benson & Bradshaw 1965; voltron/arbiter transfer) ---
//
// The lit branch is a maintaining line at DC asymptote R_T carrying a stack of
// DELAYED overvoltages. The transferring form is the nonlinear lagged-current
// overvoltage
//     g(I) = V0 + I*R_T + Σ_i k_i * ln( I / Ī_i )
// where Ī_i is a first-order lag of the tube current (one state slot per
// section), FROZEN within the NR solve and relaxed by the exact exponential
// after it. Each section reduces to a small-signal R_i‖L_i (R_i = k_i/I,
// L_i = R_i*τ_i); a zero k_i disables its section with no special case.
//
// The device is voltage-implicit (I sits inside the log), so this helper
// INVERTS g(I) = v_d for I. It solves in the LOG DOMAIN, x = ln(I):
//     r(x) = v0 + R_T·e^x + S·x − Σ_i k_i·ln(Ī_i) − v_d = 0,   S = Σ_i k_i
//     r'(x) = R_T·e^x + S > 0   (convex + monotone ⇒ globally convergent from
//                                any start; I = e^x > 0 ALWAYS)
// Returns (i_dev, jdev) with jdev = 1/g'(I) = 1/(R_T + S/I) > 0. This REPLACES
// the earlier I-domain Newton, whose warm start (v_d−v0)/denom went NEGATIVE for
// v_d < v0 and then froze (max(cur,eps) pinned g' ≈ S/eps ≈ 4e13, so Newton
// could not move): it returned a spurious negative current that tripped
// extinction at the V0 knee AND made jdev ≈ 0 in the outer NR (tube looked open,
// could not pull the reservoir below V0) — killing the whole sub-V0 tail. The
// log domain has no negative-current / derivative-freeze failure mode: e^x > 0
// for every x, and r is convex so Newton descends to the unique root from the
// warm start on either side of v0. IFLOOR is the initial Ī_i SEED only (the
// normal-glow onset current), NOT a running clamp. Positive-side (v_d > v0)
// results are unchanged: the log equation is the same g(I) = v_d, and its root
// is identical wherever the I-domain form converged. Scalar/fixed-cap/no-alloc.

/// Solve the relaxing lit-branch device relation `g(I) = v_d` for the through
/// current `I`, returning `(i_dev, jdev)` where `jdev = 1/g'(I) > 0`. Solved in
/// the log domain (x = ln I) so I = e^x > 0 always and Newton is globally
/// convergent (convex, monotone) on both sides of v0.
///
/// `i_bar` holds the section current-lags Ī_i (frozen this solve); a section
/// with `k[i] == 0.0` contributes nothing (k·ln term vanishes; its `i_bar` is
/// irrelevant). `_ifloor` is UNUSED (IFLOOR is the seed-only onset current, not
/// a running clamp); it is retained in the signature so the two eval-site call
/// shapes and the update-hook calls stay uniform.
#[inline]
fn glow_lit_eval(v_d: f64, v0: f64, r_t: f64, k: &[f64; 4], i_bar: &[f64; 4], _ifloor: f64) -> (f64, f64) {
    // Numerical guards only (never the physical IFLOOR): ln(Ī) floor, e^x overflow.
    const GLOW_LN_TINY: f64 = 1e-300;
    const X_MAX: f64 = 700.0; // e^700 ≈ 1e304 < f64::MAX; caps overflow
    const INNER_MAX_ITER: usize = 30;
    const INNER_TOL: f64 = 1e-13;

    // S = Σ k_i ; sum_kln = Σ k_i·ln(Ī_i). Inactive sections (k_i = 0) drop out.
    let mut s = 0.0;
    let mut sum_kln = 0.0;
    for i in 0..4 {
        s += k[i];
        sum_kln += k[i] * i_bar[i].max(GLOW_LN_TINY).ln();
    }
    // Warm start x0 = (v_d − v0 + Σ k_i·ln Ī_i)/S — EXACT when R_T = 0 (r linear
    // in x). Guard the divisor for the degenerate S ≈ 0 (unphysical: all k_i = 0
    // would not emit this helper; a k-sum near 0 needs only a finite start).
    let s_div = if s.abs() > 1e-30 { s } else { 1e-30 };
    let mut x = (v_d - v0 + sum_kln) / s_div;

    for _ in 0..INNER_MAX_ITER {
        let ex = if x > X_MAX { X_MAX } else { x }.exp();
        let r = v0 + r_t * ex + s * x - sum_kln - v_d;
        let rp = r_t * ex + s; // r'(x) > 0 for physical (S>0) params
        if rp.abs() < 1e-300 {
            break;
        }
        let dx = r / rp;
        x -= dx;
        if dx.abs() < INNER_TOL {
            break;
        }
    }

    let i = if x > X_MAX { X_MAX } else { x }.exp();
    let gp = r_t + s / i; // g'(I) = R_T + S/I
    let jdev = if gp > 1e-300 { 1.0 / gp } else { 0.0 };
    (i, jdev)
}
{% endif %}
{% if emit_d %}
// --- Ignition depression D(t_off) (residual-ionisation strike-voltage drop) ---
// After a short off-time the tube strikes below VO: V_s,eff = VO − D(t_off).
// Banded log form, hard-capped so V_s,eff never falls below VM:
//     D = clamp( d_amp * ln( d_tknee / max(t_off, d_thold) ), 0, d_cap )
// d_amp = 0 gives D ≡ 0 (mechanism off); d_thold plateaus the curve below the
// measured floor; d_tknee is the off-time where D reaches 0; d_cap = VO − VM.
/// Ignition-depression voltage [V] for a since-extinction off-time `t_off` [s].
#[inline]
fn glow_D(t_off: f64, d_amp: f64, d_tknee: f64, d_thold: f64, d_cap: f64) -> f64 {
    (d_amp * (d_tknee / t_off.max(d_thold)).ln()).clamp(0.0, d_cap)
}
{% endif %}
