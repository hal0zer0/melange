// Glow-discharge / neon lamp helpers. Two independently-gated fns:
//   * glow_lit_eval  — RELAXING lit-branch inner Newton (emitted when a glow
//                      device carries active sections; `emit_lit_eval`)
//   * glow_D         — ignition-depression curve D(t_off) (emitted when a glow
//                      device has D_AMP≠0; `emit_d`)
// A no-section-no-D glow deck sees NEITHER helper (byte-identical to today).
{% if emit_lit_eval %}
// --- Relaxing lit branch (Benson & Bradshaw 1965; voltron/arbiter transfer) ---
//
// The lit branch is a maintaining line at DC asymptote R_T carrying a stack of
// DELAYED overvoltages, plus an optional STATIC subnormal term. The transferring
// form is the nonlinear lagged-current overvoltage
//     g(I) = V0 + I*R_T − κ*ln( I / I_n ) + Σ_i k_i * ln( I / Ī_i )
// where Ī_i is a first-order lag of the tube current (one state slot per
// section), FROZEN within the NR solve and relaxed by the exact exponential
// after it. Each section reduces to a small-signal R_i‖L_i (R_i = k_i/I,
// L_i = R_i*τ_i); a zero k_i disables its section with no special case.
//   κ (`ksub`, default 0) is the STATIC subnormal slope [V per e-fold of I]
//   anchored at I_n (the rated current I_K, where g = V_m): as I falls, −κ·ln(I/I_n)
//   RISES (subnormal negative dV/dI at DC). Voltron t422 / Meissner 1941: κ≈2.0.
//   It is a STATIC term (not lagged), so at DC (Ī→I ⇒ sections vanish) it gives
//   the whole gentle rise V_m→V_m+~10 V toward the extinction current; within a
//   solve the FROZEN sections add +S/I, so the per-solve slope is (S−κ)/I.
//
// The device is voltage-implicit (I sits inside the log), so this helper
// INVERTS g(I) = v_d for I. It solves in the LOG DOMAIN, x = ln(I):
//     r(x) = v0 + R_T·e^x + (S−κ)·x + κ·ln(I_n) − Σ_i k_i·ln(Ī_i) − v_d = 0,  S = Σ_i k_i
//     r'(x) = R_T·e^x + (S−κ)   (single-signed ⇒ monotone ⇒ globally convergent
//                                when R_T=0 (const) OR κ≤S; I = e^x > 0 ALWAYS.
//                                The R_T>0 && κ>S corner is non-monotone and is
//                                REJECTED at parse time. For voltron's sets κ≈2 ≪
//                                S≈43–94, so S−κ>0 and this is convex as before.)
// Returns (i_dev, jdev) with jdev = 1/g'(I) = 1/(R_T + (S−κ)/I). g'(I)<0 is
// possible only in the R_T=0 & κ>S subnormal corner; jdev is then floored to a
// small POSITIVE conductance (GLOW_GMIN) so the outer NR Jacobian stays passive
// while i_dev keeps the true (negative-slope) current (SPICE gmin analog). This REPLACES
// the earlier I-domain Newton, whose warm start (v_d−v0)/denom went NEGATIVE for
// v_d < v0 and then froze (max(cur,eps) pinned g' ≈ S/eps ≈ 4e13, so Newton
// could not move): it returned a spurious negative current that tripped
// extinction at the V0 knee AND made jdev ≈ 0 in the outer NR (tube looked open,
// could not pull the reservoir below V0) — killing the whole sub-V0 tail. The
// log domain has no negative-current / derivative-freeze failure mode: e^x > 0
// for every x, and r is convex so Newton descends to the unique root from the
// warm start on either side of v0. IFLOOR is the initial Ī_i SEED only (the
// normal-glow onset current), NOT a running clamp. Positive-side (v_d > v0)
// results are unchanged: the log equation is the same g(I) = v_d, and its root
// is identical wherever the I-domain form converged. Scalar/fixed-cap/no-alloc.

/// Solve the relaxing lit-branch device relation `g(I) = v_d` for the through
/// current `I`, returning `(i_dev, jdev)` where `jdev = 1/g'(I) > 0`. Solved in
/// the log domain (x = ln I) so I = e^x > 0 always and Newton is globally
/// convergent (convex, monotone) on both sides of v0.
///
/// `i_bar` holds the section current-lags Ī_i (frozen this solve); a section
/// with `k[i] == 0.0` contributes nothing (k·ln term vanishes; its `i_bar` is
/// irrelevant). `_ifloor` is UNUSED (IFLOOR is the seed-only onset current, not
/// a running clamp); it is retained in the signature so the two eval-site call
/// shapes and the update-hook calls stay uniform. `ksub` is the static subnormal
/// slope κ [V per e-fold] (0 = off, then this reduces EXACTLY to the prior form);
/// `i_n` is its anchor current (the rated I_K, where g = V_m).
#[inline]
fn glow_lit_eval(
    v_d: f64,
    v0: f64,
    r_t: f64,
    k: &[f64; 4],
    k_minus: &[f64; 4],
    i_bar: &[f64; 4],
    _ifloor: f64,
    ksub: f64,
    i_n: f64,
) -> (f64, f64) {
    // Numerical guards only (never the physical IFLOOR): ln(Ī) floor, e^x overflow.
    const GLOW_LN_TINY: f64 = 1e-300;
    const X_MAX: f64 = 700.0; // e^700 ≈ 1e304 < f64::MAX; caps overflow
    const INNER_MAX_ITER: usize = 30;
    const INNER_TOL: f64 = 1e-13;
    const INNER_RTOL: f64 = 1e-9; // residual exit (arbiter t481 guard c)
    // Passive Jacobian floor for the subnormal NDR corner (g'(I) ≤ 0): keep jdev a
    // small POSITIVE conductance so the outer NR stays diagonally dominant while
    // i_dev carries the true negative-slope current (SPICE gmin analog).
    const GLOW_GMIN: f64 = 1e-12;

    let ln_in = i_n.max(GLOW_LN_TINY).ln();
    // Per-section breakpoints ln(Ī_i). Each section uses its GROWTH weight k[i]
    // when the iterate current I ≥ Ī_i and its DECAY weight k_minus[i] when
    // I < Ī_i. Symmetric decks (k_minus == k) make this independent of x and the
    // whole eval reduces bit-for-bit to the prior single-weight law.
    let mut ln_bar = [0.0f64; 4];
    for i in 0..4 {
        ln_bar[i] = i_bar[i].max(GLOW_LN_TINY).ln();
    }
    // s_eff = Σ k_side − κ and c = Σ k_side·ln(Ī) − κ·ln(i_n) at the iterate x=ln I.
    // The side is chosen INSIDE this closure against the CURRENT x, so r and r'
    // are always on the same piece (arbiter t481 guard a: selecting the side once
    // from the warm start is what would let Newton cycle across a kink).
    let coeffs = |x: f64| -> (f64, f64) {
        let mut s = 0.0;
        let mut kln = 0.0;
        for i in 0..4 {
            let ki = if x >= ln_bar[i] { k[i] } else { k_minus[i] };
            s += ki;
            kln += ki * ln_bar[i];
        }
        (s - ksub, kln - ksub * ln_in)
    };
    // Warm start on the growth side (the strike solve enters with I ≫ IFLOOR, all
    // sections growth-side); the loop re-selects per iterate regardless.
    let (s_g, c_g) = coeffs(f64::INFINITY);
    let s_div = if s_g.abs() > 1e-30 { s_g } else { 1e-30 };
    let mut x = (v_d - v0 + c_g) / s_div;

    for _ in 0..INNER_MAX_ITER {
        let (s_eff, c) = coeffs(x);
        let ex = if x > X_MAX { X_MAX } else { x }.exp();
        let r = v0 + r_t * ex + s_eff * x - c - v_d;
        let rp = r_t * ex + s_eff; // r'(x); single-signed per side (Σ k_side ≥ κ+1)
        if rp.abs() < 1e-300 {
            break;
        }
        let dx = r / rp;
        x -= dx;
        if dx.abs() < INNER_TOL && r.abs() < INNER_RTOL {
            break;
        }
    }

    let i = if x > X_MAX { X_MAX } else { x }.exp();
    // Jacobian from the CONVERGED root's side (arbiter t481 guard b): recompute
    // s_eff at the final x so it reflects the piece the root actually landed on.
    let (s_eff_final, _) = coeffs(x);
    let gp = r_t + s_eff_final / i; // g'(I) = R_T + (Σ k_side − κ)/I
    let jdev = if gp > 1e-300 { 1.0 / gp } else { GLOW_GMIN };
    (i, jdev)
}
{% endif %}
{% if emit_d %}
// --- Ignition depression D(t_off) (residual-ionisation strike-voltage drop) ---
// After a short off-time the tube strikes below VO: V_s,eff = VO − D(t_off).
// Banded log form, hard-capped so V_s,eff never falls below VM:
//     D = clamp( d_amp * ln( d_tknee / max(t_off, d_thold) ), 0, d_cap )
// d_amp = 0 gives D ≡ 0 (mechanism off); d_thold plateaus the curve below the
// measured floor; d_tknee is the off-time where D reaches 0; d_cap = VO − VM.
/// Ignition-depression voltage [V] for a since-extinction off-time `t_off` [s].
#[inline]
fn glow_D(t_off: f64, d_amp: f64, d_tknee: f64, d_thold: f64, d_cap: f64) -> f64 {
    (d_amp * (d_tknee / t_off.max(d_thold)).ln()).clamp(0.0, d_cap)
}
{% endif %}
