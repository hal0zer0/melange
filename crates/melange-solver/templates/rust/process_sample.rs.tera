// =============================================================================
// MAIN PROCESS FUNCTION
// =============================================================================

{% if oversampling_factor > 1 or inject_or_tap %}/// Process a single sample at the internal (oversampled) rate{% if inject_or_tap %}, with
/// per-inner-sample `.inject` values and returning raw `.tap` node voltages{% endif %}.
///
/// Called by `process_sample()`{% if oversampling_factor > 1 %} through the oversampling chain{% endif %}.
{% if inject_or_tap %}/// `injections` are already at the internal rate (the wrapper does NOT run them
/// through the up-filter). Taps are the finalized inner-rate node voltages read
/// after Step-6c damping, before the Step-9 output pipeline (no DC-block / scale
/// / clamp / decimation).
{% endif %}#[inline(always)]
fn process_sample_inner(input: f64{% if inject_or_tap %}, injections: [f64; NUM_INJECT]{% endif %}, state: &mut CircuitState) -> {% if inject_or_tap %}([f64; NUM_OUTPUTS], [f64; NUM_TAP]){% else %}[f64; NUM_OUTPUTS]{% endif %} {
{% else %}/// Process a single audio sample through the circuit
///
/// # Arguments
{% if multi_input %}/// * `inputs` - Input voltages, one per port at INPUT_NODES
{% else %}/// * `input` - Input voltage at INPUT_NODE
{% endif %}/// * `state` - Mutable circuit state (preserved across calls)
///
/// # Returns
/// Output voltages at OUTPUT_NODES (one per output channel)
#[inline]
{% if multi_input %}pub fn process_sample(inputs: [f64; NUM_INPUTS], state: &mut CircuitState) -> [f64; NUM_OUTPUTS] {
{% else %}pub fn process_sample(input: f64, state: &mut CircuitState) -> [f64; NUM_OUTPUTS] {
{% endif %}{% endif %}
{% if multi_input %}    // Validate inputs — handle NaN, inf, and extreme values (per port)
    let mut inputs = inputs;
    for v in inputs.iter_mut() {
        *v = if v.is_finite() { v.clamp(-100.0, 100.0) } else { 0.0 };
    }
{% else %}    // Validate input — handle NaN, inf, and extreme values
    let input = if input.is_finite() { input.clamp(-100.0, 100.0) } else { 0.0 };
{% endif %}{% if inject_or_tap %}    // Sanitize injections (NaN/Inf → 0). No magnitude clamp: a feedback value
    // is arbitrary and the Step-7 plausibility guard catches any runaway.
    let mut injections = injections;
    for v in injections.iter_mut() { *v = if v.is_finite() { *v } else { 0.0 }; }
{% endif %}
{% if num_switches > 0 or num_pots > 0 %}
    // Lazy rebuild: process all pot/switch changes in one batch
    if state.matrices_dirty {
        state.rebuild_matrices();
        state.matrices_dirty = false;
    }
{% endif %}

    // Flush denormals in state vectors to prevent 50-100x CPU penalty during silence.
    // (Most DAW hosts set FTZ/DAZ, but generated code should not rely on it.)
    for v in state.v_prev.iter_mut() { *v = *v + 1e-25 - 1e-25; }
{% if m > 0 %}    for v in state.i_nl_prev.iter_mut() { *v = *v + 1e-25 - 1e-25; }
{% endif %}
{% if has_be_fallback %}    // Pre-check: force BE if cooldown active from previous ringing detection.
    let force_be = state.be_cooldown > 0;
    if state.be_cooldown > 0 { state.be_cooldown -= 1; }
{% endif %}
    // Step 1: Build RHS vector from history and input
    let {% if noise_enabled_emit %}mut {% endif %}rhs = {% if multi_input %}build_rhs(&inputs, &state.inputs_prev, state){% else %}build_rhs(input, state.input_prev, {% if inject_or_tap %}&injections, {% endif %}state){% endif %};
{% if noise_enabled_emit %}{{ noise_rhs_stamp }}{% endif %}
    // Step 2: Linear prediction: v_pred = S * rhs
    let v_pred = mat_vec_mul_s(&rhs, state);

    // Step 3: Extract controlling voltages for nonlinear devices
    let p = extract_controlling_voltages(&v_pred);
{% if body_effect_update is defined and body_effect_update != "" %}

    // Step 3c: MOSFET body effect — update VT from predicted node voltages
{{ body_effect_update }}{% endif %}

    // Step 4: Solve M×M nonlinear system via Newton-Raphson
    let i_nl = solve_nonlinear(&p, state);

    // Step 5: Compute final node voltages
    let {% if opamp_clamps is defined and opamp_clamps | length > 0 %}mut {% endif %}v = compute_final_voltages(&v_pred, &i_nl, state);
{% if opamp_clamps is defined and opamp_clamps | length > 0 %}

    // Step 5c: Op-amp output voltage clamping (VCC/VEE supply rails)
{% for clamp in opamp_clamps %}    v[{{ clamp.out_idx }}] = v[{{ clamp.out_idx }}].clamp({{ clamp.lo }}, {{ clamp.hi }});
{% endfor %}{% endif %}

    // Step 6: Update history (no-op, handled by A_neg formulation)
    update_history(&v, state);
{% if has_be_fallback %}
    // Step 6b: Backward Euler fallback for trapezoidal instability.
    // Triggers when: (a) trapezoidal NR didn't converge, OR (b) any node voltage
    // exceeds supply rails (trapezoidal ringing artifact), OR (c) previous sample
    // used BE (cooldown: stay on BE until ringing decays).
    // BE is L-stable and damps all oscillatory modes that trapezoidal preserves.
    let nr_failed = state.last_nr_iterations >= {{ max_iter }}_u32;
    let ringing = v.iter().take({{ n_nodes }}).any(|&x| x.abs() > {{ v_max_dc }});
    let need_be = nr_failed || ringing || force_be;
    let (v, i_nl) = if need_be {
        if nr_failed { state.diag_nr_max_iter_count += 1; }
        // Set cooldown: stay on BE long enough for trapezoidal ringing to decay.
        // 64 samples ≈ 1.5ms at 44.1kHz — enough for most parasitic modes.
        if ringing || nr_failed { state.be_cooldown = 64; }
        state.diag_be_fallback_count += 1;
        // Rebuild RHS with backward Euler matrices.
        //
        // This is the per-sample BE *fallback* inside a trapezoidal-primary
        // solver — NOT a BE-primary integrator. The surrounding solver keeps
        // `i_nl_prev` on the trap convention: every trap `build_rhs` consumes
        // `N_I * i_nl_prev` (baked into v_pred). A fallback sample rebuilds the
        // RHS from scratch, so it must consume `i_nl_prev` the same way or the
        // previous sample's nonlinear charge is dropped — injecting a transient
        // on every fallback (e.g. ~3× hot output where the fallback is
        // load-bearing, and the `.runtime R` modulation pump). The "BE omits
        // N_I*i_nl_prev" rule applies only to BE-*primary* codegen (every sample
        // BE, i_nl_prev never trap-split), gated separately in
        // dk_emitter::emit_build_rhs.
        // Sparse-pruned A_neg_be·v_prev + N_I·i_nl_prev (+ RHS_CONST_BE when DC
        // sources present). Generated per-row from the A_neg_be / N_i patterns.
        let mut rhs_be = [0.0f64; N];
{{ be_rhs_lines }}
{% if multi_input %}        for k in 0..NUM_INPUTS {
            rhs_be[INPUT_NODES[k]] += inputs[k] / INPUT_RESISTANCES[k];
        }
{% else %}        rhs_be[INPUT_NODE] += input / INPUT_RESISTANCE;
{% endif %}{% if inject_or_tap %}        // Injections in the BE-fallback RHS: same rows as build_rhs. BE drops
        // the trapezoidal history term (Thevenin uses val/R; Norton is a
        // current source, integration-scheme-independent).
        for k in 0..NUM_INJECT {
            if INJECT_IS_NORTON[k] {
                rhs_be[INJECT_NODES[k]] += injections[k];
            } else {
                rhs_be[INJECT_NODES[k]] += injections[k] / INJECT_RESISTANCES[k];
            }
        }
{% endif %}
{% if runtime_sources | length > 0 %}        // Runtime voltage sources (.runtime directive): same rows/values as
        // build_rhs — VS algebraic rows are integration-scheme-independent
        // (×1 for both trap and BE), so a fallback sample must not drop them.
{% for rt in runtime_sources %}        rhs_be[{{ rt.vs_row }}] += state.{{ rt.field_name }};
{% endfor %}{% endif %}{% if noise_enabled_emit %}{{ noise_rhs_stamp_be }}{% endif %}
        // BE linear prediction: v_pred_be = S_be * rhs_be
        let mut v_pred_be = [0.0f64; N];
        for i in 0..N {
            let mut sum = 0.0;
            for j in 0..N { sum += state.s_be[i][j] * rhs_be[j]; }
            v_pred_be[i] = sum;
        }
        // BE controlling voltages
        // Sparse-pruned N_V·v_pred_be (BE controlling voltages).
        let mut p_be = [0.0f64; M];
{{ be_p_lines }}
        // BE NR solve: swap k/k_be so solve_nonlinear uses BE kernel
        std::mem::swap(&mut state.k, &mut state.k_be);
        std::mem::swap(&mut state.s_ni, &mut state.s_ni_be);
        let i_nl_be = solve_nonlinear(&p_be, state);
        std::mem::swap(&mut state.k, &mut state.k_be);
        std::mem::swap(&mut state.s_ni, &mut state.s_ni_be);
        // Recover full v from BE
        let mut v_be = v_pred_be;
        for i in 0..N {
            for j in 0..M { v_be[i] += state.s_ni_be[i][j] * i_nl_be[j]; }
        }
{% if opamp_clamps is defined and opamp_clamps | length > 0 %}
        // Op-amp supply rail clamping (BE path)
{% for clamp in opamp_clamps %}        v_be[{{ clamp.out_idx }}] = v_be[{{ clamp.out_idx }}].clamp({{ clamp.lo }}, {{ clamp.hi }});
{% endfor %}{% endif %}
        (v_be, i_nl_be)
    } else {
        (v, i_nl)
    };
{% endif %}

    // Step 6c: Global node voltage damping safety net.
    // Threshold scales with max DC OP voltage so tube 250V circuits aren't over-damped.
    let (v, i_nl) = {
        let mut max_delta = 0.0_f64;
        for i in 0..{{ n_nodes }} {
            let d = (v[i] - state.v_prev[i]).abs();
            if d > max_delta { max_delta = d; }
        }
        // Adaptive threshold: max(2V, 5% of max DC OP node voltage). Cached in
        // state.damp_thresh (refreshed only when dc_operating_point changes)
        // instead of recomputing the max over all nodes every sample.
        let damp_thresh = state.damp_thresh;
        if max_delta > damp_thresh {
            // This is a last-ditch safety net that should only fire when the
            // solver has produced a pathological step. A nonzero value here is
            // a symptom that needs investigation, not an acceptable steady-state
            // (per CLAUDE.md: "never use output attenuation to mask simulation
            // errors"). Surfaced via state.diag_voltage_damp_count.
            state.diag_voltage_damp_count = state.diag_voltage_damp_count.saturating_add(1);
            // Uncapped division — `damp_thresh` and `max_delta` are both
            // strictly positive here (max_delta > damp_thresh > 0), so
            // `damp` is always strictly positive; a `.max(0.01)` floor would
            // re-admit at least 1% of an arbitrarily large `max_delta`
            // instead of clamping the step to `damp_thresh` as intended.
            // Same anti-pattern/fix as the NR per-iteration voltage-limiting
            // floors in `nr_helpers.rs` and the nodal node-step damping
            // floor removed in `e6d5db8` — see docs/aidocs/VOLTAGE_LIMITING.md
            // "Global Node-Step Damping". Do NOT reintroduce a floor here.
            let damp = damp_thresh / max_delta;
            let mut v_d = v;
            for i in 0..N {
                v_d[i] = state.v_prev[i] + damp * (v[i] - state.v_prev[i]);
            }
            let mut i_d = i_nl;
            for i in 0..M {
                i_d[i] = state.i_nl_prev[i] + damp * (i_nl[i] - state.i_nl_prev[i]);
            }
            (v_d, i_d)
        } else {
            (v, i_nl)
        }
    };

{% if opamp_slew is defined and opamp_slew | length > 0 %}
    // Step 6d: Op-amp slew-rate limiting.
    // For each op-amp with a finite `.model OA(SR=…)`, clamp the per-sample
    // voltage delta at the output node to ±SR*dt. Equivalent to clamping
    // the Boyle dominant-pole integrator input current to ±SR*C_dom (the
    // physical `I_slew = SR*C_dom` tail-current limit of a real op-amp).
    //
    // Applied AFTER rail clamping and the damping safety net so slew-limited
    // transients can't exceed the rails, and BEFORE state.v_prev = v so the
    // next sample's cap history reflects the slew-limited voltage
    // (preserves KCL across the sample boundary).
    let mut v = v;
    // Runtime host rate (state.current_sample_rate), NOT the baked SAMPLE_RATE
    // const — a 96 kHz host running a 44.1k-compiled circuit would otherwise
    // get ~2.2x loose slew limiting. Mirrors the nodal-emitter fix (7e32bf8).
    let _oa_slew_dt = 1.0 / (state.current_sample_rate * OVERSAMPLING_FACTOR as f64);
{% for s in opamp_slew %}    {
        let prev = state.v_prev[{{ s.out_idx }}];
        let max_dv = OA{{ s.idx }}_SR * _oa_slew_dt;
        let delta = v[{{ s.out_idx }}] - prev;
        v[{{ s.out_idx }}] = prev + delta.clamp(-max_dv, max_dv);
    }
{% endfor %}{% endif %}

    // Step 7: Check for NaN/Inf and finite-but-implausible magnitude BEFORE
    // updating state (prevents corruption of v_prev/i_nl_prev). A saturated
    // solve (e.g. codegen exp() clamp, near-singular LU) can produce a
    // huge-but-finite value that bypasses `is_finite()` and would otherwise
    // propagate into v_prev forever. See STATE_MAX_PLAUSIBLE_MAGNITUDE doc.
    let v_is_finite = v.iter().all(|x| x.is_finite());
    if !v_is_finite || v.iter().any(|x| x.abs() > STATE_MAX_PLAUSIBLE_MAGNITUDE) {
        state.v_prev = state.dc_operating_point;
{% if has_dc_nl %}        state.i_nl_prev = DC_NL_I;
        state.i_nl_prev_prev = DC_NL_I;
{% else %}        state.i_nl_prev = [0.0; M];
        state.i_nl_prev_prev = [0.0; M];
{% endif %}
{% if multi_input %}        state.inputs_prev = [0.0; NUM_INPUTS];
{% else %}        state.input_prev = 0.0;
{% endif %}{% if inject_or_tap %}        state.injections_prev = [0.0; NUM_INJECT];
{% endif %}{% if num_inductors > 0 %}        state.ind_i_prev = [0.0; {{ num_inductors }}];
        state.ind_v_prev = [0.0; {{ num_inductors }}];
        state.ind_i_hist = [0.0; {{ num_inductors }}];
{% endif %}{% if num_coupled_inductors > 0 %}        state.ci_i1_prev = [0.0; {{ num_coupled_inductors }}];
        state.ci_i2_prev = [0.0; {{ num_coupled_inductors }}];
        state.ci_v1_prev = [0.0; {{ num_coupled_inductors }}];
        state.ci_v2_prev = [0.0; {{ num_coupled_inductors }}];
        state.ci_i1_hist = [0.0; {{ num_coupled_inductors }}];
        state.ci_i2_hist = [0.0; {{ num_coupled_inductors }}];
{% endif %}{% if num_transformer_groups > 0 %}{{ xfmr_nan_reset_lines }}{% endif %}{# NaN recovery deliberately does NOT touch pot/switch fields: the live
   matrices were built at the actual knob positions and remain valid —
   snapping the fields to nominal here would create a field/matrix
   disagreement that the setters' unchanged-value check could then lock in.
#}{% if num_thermal_devices > 0 %}{% for td in thermal_devices %}        state.device_{{ td.dev_num }}_tj = DEVICE_{{ td.dev_num }}_TAMB;
{% if td.has_is_scaling %}        state.device_{{ td.dev_num }}_is = DEVICE_{{ td.dev_num }}_IS;
        state.device_{{ td.dev_num }}_{{ td.vt_field_name }} = DEVICE_{{ td.dev_num }}_{{ td.vt_const_name }};
{% endif %}{% endfor %}{% endif %}{% if has_be_fallback %}        state.be_cooldown = 0;
{% endif %}{% if oversampling_factor > 1 %}        state.os_up_state = [0.0; {{ os_state_size }}];
        state.os_dn_state = [[0.0; {{ os_state_size }}]; NUM_OUTPUTS];
{% endif %}{% if oversampling_4x %}        state.os_up_state_outer = [0.0; {{ os_state_size_outer }}];
        state.os_dn_state_outer = [[0.0; {{ os_state_size_outer }}]; NUM_OUTPUTS];
{% endif %}{% if noise_enabled_emit %}{{ noise_nan_recovery }}{% endif %}{% if stateful_nan_recovery is defined and stateful_nan_recovery != "" %}{{ stateful_nan_recovery }}{% endif %}        if v_is_finite { state.diag_magnitude_reset_count += 1; } else { state.diag_nan_reset_count += 1; }
        // Return DC operating point output instead of zero to avoid discontinuity
        let mut dc_output = [0.0f64; NUM_OUTPUTS];
        for out_idx in 0..NUM_OUTPUTS {
            let raw = state.dc_operating_point[OUTPUT_NODES[out_idx]];
            dc_output[out_idx] = (raw * OUTPUT_SCALES[out_idx]).clamp(-{{ output_clamp_v }}, {{ output_clamp_v }});
        }
{% if inject_or_tap %}        // Raw taps fall back to the DC operating point (v is invalid here).
        let mut dc_taps = [0.0f64; NUM_TAP];
        for t in 0..NUM_TAP { dc_taps[t] = state.dc_operating_point[TAP_NODES[t]]; }
        return (dc_output, dc_taps);
{% else %}        return dc_output;
{% endif %}    }

{% if stateful_update is defined and stateful_update != "" %}    // Step 6z: stateful-device update (after solve, on converged driving-node
    // voltage(s), BEFORE state.v_prev = v so v_prev is still the prior sample)
{{ stateful_update }}{% endif %}    // Update state for next iteration
    state.v_prev = v;
    state.i_nl_prev_prev = state.i_nl_prev;
    state.i_nl_prev = i_nl;
{% if multi_input %}    state.inputs_prev = inputs;
{% else %}    state.input_prev = input;
{% endif %}{% if inject_or_tap %}    state.injections_prev = injections;
{% endif %}
{% if num_inductors > 0 %}

    // Step 7b: Update inductor companion model state
{% for ind in inductors %}    {
        let v_i = {% if ind.node_i > 0 %}v[{{ ind.node_i - 1 }}]{% else %}0.0{% endif %};
        let v_j = {% if ind.node_j > 0 %}v[{{ ind.node_j - 1 }}]{% else %}0.0{% endif %};
        let v_new = v_i - v_j;
        let g_eq = state.ind_g_eq[{{ loop.index0 }}];
        let i_new = state.ind_i_prev[{{ loop.index0 }}] + g_eq * (state.ind_v_prev[{{ loop.index0 }}] + v_new);
        // Doubled-trapezoidal history: the DK RHS sums the KCL of steps n
        // and n-1, so the injection is i_L[n] + i_L[n-1] minus the
        // g_eq*(v[n]+v[n-1]) part already carried by the g_eq stamp in
        // A / A_neg — leaving exactly 2*i[n-1].
        state.ind_i_hist[{{ loop.index0 }}] = 2.0 * i_new;
        state.ind_i_prev[{{ loop.index0 }}] = i_new;
        state.ind_v_prev[{{ loop.index0 }}] = v_new;
    }
{% endfor %}{% endif %}
{% if num_coupled_inductors > 0 %}
    // Step 7c: Update coupled inductor companion model state
{% for ci in coupled_inductors %}    {
        let v1_i = {% if ci.l1_node_i > 0 %}v[{{ ci.l1_node_i - 1 }}]{% else %}0.0{% endif %};
        let v1_j = {% if ci.l1_node_j > 0 %}v[{{ ci.l1_node_j - 1 }}]{% else %}0.0{% endif %};
        let v1_new = v1_i - v1_j;
        let v2_i = {% if ci.l2_node_i > 0 %}v[{{ ci.l2_node_i - 1 }}]{% else %}0.0{% endif %};
        let v2_j = {% if ci.l2_node_j > 0 %}v[{{ ci.l2_node_j - 1 }}]{% else %}0.0{% endif %};
        let v2_new = v2_i - v2_j;
        let gs1 = state.ci_g_self_1[{{ loop.index0 }}];
        let gs2 = state.ci_g_self_2[{{ loop.index0 }}];
        let gm = state.ci_g_mutual[{{ loop.index0 }}];
        let i1_new = state.ci_i1_prev[{{ loop.index0 }}] + gs1 * (state.ci_v1_prev[{{ loop.index0 }}] + v1_new) + gm * (state.ci_v2_prev[{{ loop.index0 }}] + v2_new);
        let i2_new = state.ci_i2_prev[{{ loop.index0 }}] + gm * (state.ci_v1_prev[{{ loop.index0 }}] + v1_new) + gs2 * (state.ci_v2_prev[{{ loop.index0 }}] + v2_new);
        // Doubled-trapezoidal history (vector form): 2*i[n-1] per winding;
        // the Y*(v[n]+v[n-1]) part is already in the A / A_neg stamps.
        state.ci_i1_hist[{{ loop.index0 }}] = 2.0 * i1_new;
        state.ci_i2_hist[{{ loop.index0 }}] = 2.0 * i2_new;
        state.ci_i1_prev[{{ loop.index0 }}] = i1_new;
        state.ci_i2_prev[{{ loop.index0 }}] = i2_new;
        state.ci_v1_prev[{{ loop.index0 }}] = v1_new;
        state.ci_v2_prev[{{ loop.index0 }}] = v2_new;
    }
{% endfor %}{% endif %}
{% if num_transformer_groups > 0 %}
    // Step 7d: Update transformer group companion model state
{{ xfmr_update_lines }}{% endif %}

{% if thermal_update is defined and thermal_update != "" %}
    // Step 7e: BJT self-heating thermal update (quasi-static, outside NR)
{{ thermal_update }}{% endif %}

    // (NaN check already done in Step 7, before state update)

    {% if m > 0 %}
    if state.last_nr_iterations >= {{ max_iter }}_u32 {
        state.diag_nr_max_iter_count += 1;
    }
    {% endif %}
{% if region_exit_lines is defined and region_exit_lines != "" %}
{{ region_exit_lines }}{% endif %}
    // Step 9: Extract outputs{% if dc_block %}, apply per-output DC blocking filter{% endif %} and scale
    let mut output = [0.0f64; NUM_OUTPUTS];
    for out_idx in 0..NUM_OUTPUTS {
        let raw_out = v[OUTPUT_NODES[out_idx]];
        let raw_out = if raw_out.is_finite() { raw_out } else { 0.0 };
{% if dc_block %}        let dc_blocked = raw_out - state.dc_block_x_prev[out_idx]
            + state.dc_block_r * state.dc_block_y_prev[out_idx];
        state.dc_block_x_prev[out_idx] = raw_out;
        // Tiny bias prevents denormals in DC block feedback during silence.
        // No magnitude clamp here: the feedback state must track the true
        // filter output or circuits with legitimate >100 V swings (tube
        // plates) get a corrupted HPF state and a nonlinear artifact
        // (masking class — output limiting belongs to the final clamp only).
        state.dc_block_y_prev[out_idx] = dc_blocked + 1e-20;
        let scaled = dc_blocked * OUTPUT_SCALES[out_idx];
{% else %}        let scaled = raw_out * OUTPUT_SCALES[out_idx];
{% endif %}        let abs_out = scaled.abs();
        if abs_out > state.diag_peak_output { state.diag_peak_output = abs_out; }
{% if dc_block %}        if abs_out > {{ output_clamp_v }} { state.diag_clamp_count += 1; }
        output[out_idx] = scaled.clamp(-{{ output_clamp_v }}, {{ output_clamp_v }});
{% else %}        output[out_idx] = if scaled.is_finite() { scaled } else { 0.0 };
{% endif %}
    }
{% if inject_or_tap %}    // Raw inner-rate taps: the finalized node voltages after Step-6c damping,
    // WITHOUT the Step-9 output pipeline (no DC-block, scale, clamp, or
    // decimation). The wrapper passes these through untouched.
    let mut taps = [0.0f64; NUM_TAP];
    for t in 0..NUM_TAP {
        let raw = v[TAP_NODES[t]];
        taps[t] = if raw.is_finite() { raw } else { 0.0 };
    }
    (output, taps)
{% else %}    output
{% endif %}}
