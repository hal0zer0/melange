// =============================================================================
// STATE STRUCTURE
// =============================================================================

{% if has_dc_op %}/// DC operating point: steady-state node voltages
pub const DC_OP: [f64; N] = [{{ dc_op_values }}];

{% endif %}{% if has_cap_ic %}/// Initial-state seed for `v_prev`: node voltages after solving the DC
/// system with each `IC=`-bearing capacitor temporarily replaced by an
/// ideal DC voltage source of that value (SPICE `.IC`/UIC semantics).
/// Affects only capacitors carrying an explicit `IC=`; used solely to seed
/// the transient's `v_prev`. `DC_OP` above (when present) remains the pure
/// IC-free DC bias point.
pub const V_PREV_IC_SEED: [f64; N] = [{{ v_prev_ic_values }}];

{% endif %}{% if has_dc_nl %}/// DC operating point: nonlinear device currents at bias point
pub const DC_NL_I: [f64; M] = [{{ dc_nl_i_values }}];

{% endif %}{% if has_dc_nl_ic_seed %}/// Nonlinear device currents at the same IC-seeded operating point as
/// `V_PREV_IC_SEED`. MUST be used together with `V_PREV_IC_SEED` to seed
/// `i_nl_prev`/`i_nl_prev_prev` — never with the plain `DC_OP`/`DC_NL_I`
/// pair, which the per-sample magnitude/NaN-reset fallback resets state to.
/// Pairing `V_PREV_IC_SEED` with `DC_NL_I` (device currents at the
/// *unperturbed* bias point) would feed a KCL-inconsistent state into the
/// first trapezoidal step and diverge a few hundred samples in.
pub const DC_NL_I_IC_SEED: [f64; M] = [{{ dc_nl_i_ic_seed_values }}];

{% endif %}/// Circuit state for one processing channel.
///
/// Contains both per-sample state (v_prev, i_nl_prev) and sample-rate-dependent
/// matrices (s, a_neg, k, s_ni). Call [`set_sample_rate`](CircuitState::set_sample_rate)
/// before processing if the host sample rate differs from [`SAMPLE_RATE`].
#[derive(Clone, Debug)]
pub struct CircuitState {
    /// Previous node voltages v[n-1]
    pub v_prev: [f64; N],

    /// Previous nonlinear currents i_nl[n-1]
    pub i_nl_prev: [f64; M],

    /// Nonlinear currents from two samples ago i_nl[n-2] (for NR predictor)
    pub i_nl_prev_prev: [f64; M],

    /// DC operating point (for reset/sleep/wake)
    pub dc_operating_point: [f64; N],

    /// Cached Step-6c damping threshold = max|dc_operating_point[0..n_nodes]|
    /// .mul_add(0.05, 2.0). Loop-invariant between DC-OP changes, so it is
    /// refreshed only when dc_operating_point is mutated (Default, reset,
    /// set_dc_operating_point, recompute_dc_op) rather than recomputed every
    /// sample in the process_sample safety net.
    pub damp_thresh: f64,

    /// Previous input sample(s) for trapezoidal integration
{% if multi_input %}    pub inputs_prev: [f64; NUM_INPUTS],
{% else %}    pub input_prev: f64,
{% endif %}{% if inject_or_tap %}    /// Previous `.inject` values (per inner sample), for the trapezoidal
    /// history term of Thevenin injections. Advanced once per inner call
    /// alongside `input_prev`.
    pub injections_prev: [f64; NUM_INJECT],
{% endif %}

    /// Iteration count from last solve (for diagnostics)
    pub last_nr_iterations: u32,

{% if dc_block %}    /// DC blocking filter: previous input samples (one per output)
    pub dc_block_x_prev: [f64; NUM_OUTPUTS],
    /// DC blocking filter: previous output samples (one per output)
    pub dc_block_y_prev: [f64; NUM_OUTPUTS],
    /// DC blocking filter coefficient (recomputed on sample rate change)
    pub dc_block_r: f64,
{% endif %}
    /// Diagnostic: peak absolute output (pre-clamp)
    pub diag_peak_output: f64,
    /// Diagnostic: number of times output exceeded the configured output clamp
    pub diag_clamp_count: u64,
    /// Diagnostic: number of times NR hit max iterations
    pub diag_nr_max_iter_count: u64,
    /// Diagnostic: number of times NaN triggered state reset
    pub diag_nan_reset_count: u64,
    /// Diagnostic: number of times a finite-but-implausible iterate (state
    /// magnitude beyond any physically-realizable circuit value) triggered
    /// state reset. NaN/Inf is caught by `diag_nan_reset_count`; this counts
    /// the "diverged but still `is_finite()`" gap (e.g. a codegen exp()-clamp
    /// saturation or a near-singular NR solve producing an astronomically
    /// large finite value that would otherwise bypass every NaN guard and
    /// propagate). See docs/aidocs/DEBUGGING.md "finite runaway" entry.
    pub diag_magnitude_reset_count: u64,
    /// Diagnostic: number of times matrix inversion detected a singular matrix
    pub diag_singular_matrix_count: u64,
    /// Diagnostic: number of samples hit by the global voltage-damping safety
    /// net. Per CLAUDE.md ("never use output attenuation to mask simulation
    /// errors"), any nonzero value here is a symptom to investigate, not an
    /// acceptable steady-state.
    pub diag_voltage_damp_count: u64,
    /// Diagnostic: number of times sub-step NR was used (nodal full-LU only;
    /// always 0 on the DK path)
    pub diag_substep_count: u64,

    /// S = A^{-1} matrix, recomputed by set_sample_rate
    pub s: [[f64; N]; N],

    /// A_neg = alpha*C - G matrix, recomputed by set_sample_rate
    pub a_neg: [[f64; N]; N],

    /// K = N_v * S * N_i kernel matrix, recomputed by set_sample_rate
    pub k: [[f64; M]; M],

    /// S * N_i product, recomputed by set_sample_rate
    pub s_ni: [[f64; M]; N],
{% if has_be_fallback %}
    /// S_be = A_be^{-1} (backward Euler), recomputed by set_sample_rate
    pub s_be: [[f64; N]; N],

    /// K_be = N_v * S_be * N_i (backward Euler kernel), recomputed by set_sample_rate
    pub k_be: [[f64; M]; M],

    /// S_be * N_i product (backward Euler), recomputed by set_sample_rate
    pub s_ni_be: [[f64; M]; N],

    /// A_neg_be = (1/T)*C (backward Euler history), recomputed by set_sample_rate
    pub a_neg_be: [[f64; N]; N],

    /// BE cooldown: remaining samples to force backward Euler after ringing detected.
    /// Decays to 0, then trapezoidal resumes. Prevents trap→BE→trap oscillation.
    pub be_cooldown: u32,
{% endif %}
    /// Diagnostic: number of backward Euler fallback activations
    pub diag_be_fallback_count: u64,
{% if num_inductors > 0 %}
    /// Inductor previous currents
    pub ind_i_prev: [f64; {{ num_inductors }}],
    /// Inductor previous voltages
    pub ind_v_prev: [f64; {{ num_inductors }}],
    /// Inductor history currents (Norton equivalent)
    pub ind_i_hist: [f64; {{ num_inductors }}],
    /// Inductor equivalent conductances (sample-rate dependent)
    pub ind_g_eq: [f64; {{ num_inductors }}],
{% endif %}
{% if num_coupled_inductors > 0 %}
    /// Coupled inductor L1 previous currents
    pub ci_i1_prev: [f64; {{ num_coupled_inductors }}],
    /// Coupled inductor L2 previous currents
    pub ci_i2_prev: [f64; {{ num_coupled_inductors }}],
    /// Coupled inductor L1 previous voltages
    pub ci_v1_prev: [f64; {{ num_coupled_inductors }}],
    /// Coupled inductor L2 previous voltages
    pub ci_v2_prev: [f64; {{ num_coupled_inductors }}],
    /// Coupled inductor L1 history currents (Norton equivalent)
    pub ci_i1_hist: [f64; {{ num_coupled_inductors }}],
    /// Coupled inductor L2 history currents (Norton equivalent)
    pub ci_i2_hist: [f64; {{ num_coupled_inductors }}],
    /// Coupled inductor self-conductances and mutual conductance (sample-rate dependent)
    pub ci_g_self_1: [f64; {{ num_coupled_inductors }}],
    pub ci_g_self_2: [f64; {{ num_coupled_inductors }}],
    pub ci_g_mutual: [f64; {{ num_coupled_inductors }}],
{% endif %}
{% if num_transformer_groups > 0 %}
{% for g in transformer_groups %}
    /// Transformer group {{ g.index }} admittance matrix Y (flat {{ g.num_windings }}x{{ g.num_windings }}, sample-rate dependent)
    pub xfmr_{{ g.index }}_y: [f64; {{ g.num_windings * g.num_windings }}],
    /// Transformer group {{ g.index }} previous winding currents
    pub xfmr_{{ g.index }}_i_prev: [f64; {{ g.num_windings }}],
    /// Transformer group {{ g.index }} previous winding voltages
    pub xfmr_{{ g.index }}_v_prev: [f64; {{ g.num_windings }}],
    /// Transformer group {{ g.index }} history currents (Norton equivalent)
    pub xfmr_{{ g.index }}_i_hist: [f64; {{ g.num_windings }}],
{% endfor %}
{% endif %}
{% for default in pot_defaults %}
    /// Potentiometer {{ loop.index0 }} current resistance (ohms)
    pub pot_{{ loop.index0 }}_resistance: f64,
    /// Potentiometer {{ loop.index0 }} previous timestep resistance (for trapezoidal A_neg correction)
    pub pot_{{ loop.index0 }}_resistance_prev: f64,
{% endfor %}
{% if oversampling_factor > 1 %}
    /// Oversampler upsampling half-band filter state (single input)
    pub os_up_state: [f64; {{ os_state_size }}],
    /// Oversampler downsampling half-band filter state (per output)
    pub os_dn_state: [[f64; {{ os_state_size }}]; NUM_OUTPUTS],
{% endif %}{% if oversampling_4x %}
    /// 4x oversampler outer upsampling filter state (single input)
    pub os_up_state_outer: [f64; {{ os_state_size_outer }}],
    /// 4x oversampler outer downsampling filter state (per output)
    pub os_dn_state_outer: [[f64; {{ os_state_size_outer }}]; NUM_OUTPUTS],
{% endif %}
{% if num_switches > 0 %}
{% for idx in switch_indices %}
    /// Switch {{ idx }} current position (0-indexed)
    pub switch_{{ idx }}_position: usize,
{% endfor %}
{% endif %}
{% if needs_current_sr %}
    /// Current host sample rate (needed for rebuild_matrices and the op-amp
    /// slew-rate limiter's per-sample dt)
    pub current_sample_rate: f64,
{% endif %}
{% if num_switches > 0 or num_pots > 0 %}
    /// Lazy rebuild flag: set by set_pot/set_switch, cleared by process_sample
    pub matrices_dirty: bool,
{% endif %}
{# SM state fields removed — per-block rebuild replaces SM #}
{% if num_device_params > 0 %}
    // --- Runtime-adjustable device parameters ---
    // These fields are initialized from the corresponding DEVICE_N_* constants.
    // Modify them at runtime to change device behavior (e.g. tube aging, transistor matching).
{% for dev in device_params %}{% for p in dev.params %}
    /// Device {{ dev.dev_num }} {{ p.const_suffix }} ({{ dev.device_type }}) — runtime adjustable
    pub device_{{ dev.dev_num }}_{{ p.field_suffix }}: f64,
{% endfor %}{% endfor %}
{% endif %}
{% if num_thermal_devices > 0 %}
    // --- Device self-heating thermal state (BJT and diode) ---
{% for td in thermal_devices %}
    /// Device {{ td.dev_num }} junction temperature [K]
    pub device_{{ td.dev_num }}_tj: f64,
{% endfor %}
{% endif %}
{% if noise_enabled_emit %}
    // --- Authentic circuit noise (Phase 1: thermal) ---
{{ noise_state_fields }}{% endif %}
{% if runtime_sources | length > 0 %}
    // --- Runtime voltage sources (.runtime directive) ---
    // Host writes these each sample; RHS builder stamps them into the VS
    // row of the augmented system. Additive with any DC bias declared on
    // the voltage source itself.
{% for rt in runtime_sources %}    /// Runtime value for voltage source {{ rt.vs_name }} (RHS row {{ rt.vs_row }}).
    pub {{ rt.field_name }}: f64,
{% endfor %}{% endif %}
}

{% if opamp_rail_degrade_warn is defined %}/// One-shot latch for the DK rail-mode degradation warning emitted from
/// `Default::default()` — fires at most once per process, not per channel.
static OPAMP_RAIL_DEGRADE_WARN_ONCE: std::sync::Once = std::sync::Once::new();

{% endif %}impl Default for CircuitState {
    fn default() -> Self {
{% if opamp_rail_degrade_warn is defined %}        OPAMP_RAIL_DEGRADE_WARN_ONCE.call_once(|| {
            eprintln!("{{ opamp_rail_degrade_warn }}");
        });
{% endif %}{% if noise_enabled_emit %}{{ noise_default_stmts }}{% endif %}{% if dc_block and (has_dc_op or has_cap_ic) %}{% if has_cap_ic %}        // Seed the DC blocker's x[n-1] with the true t=0 output value, so the
        // first processed sample doesn't see a spurious startup thump from the
        // blocker's own history mismatch. V_PREV_IC_SEED when the circuit has
        // IC=-bearing caps (their prescribed initial voltage IS the t=0 state),
        // else the plain DC operating point. Mirrors Phase E's
        // recompute_dc_op() reseed contract.
{% else %}        // Seed the DC blocker's x[n-1] with the output-node DC operating point.
        // Starting from 0 while v_prev = DC_OP injects a deterministic startup
        // thump of ~DC_OP[out]*SCALE decaying at the 5 Hz blocker pole
        // (tau ~ 32 ms). Mirrors Phase E's recompute_dc_op() reseed contract.
{% endif %}        let mut dc_block_x_seed = [0.0f64; NUM_OUTPUTS];
{% if has_cap_ic %}        for k in 0..NUM_OUTPUTS { dc_block_x_seed[k] = V_PREV_IC_SEED[OUTPUT_NODES[k]]; }
{% else %}        for k in 0..NUM_OUTPUTS { dc_block_x_seed[k] = DC_OP[OUTPUT_NODES[k]]; }
{% endif %}{% endif %}        Self {
{% if has_dc_op %}            v_prev: {% if has_cap_ic %}V_PREV_IC_SEED{% else %}DC_OP{% endif %},
{% if has_dc_nl_ic_seed %}            i_nl_prev: DC_NL_I_IC_SEED,
            i_nl_prev_prev: DC_NL_I_IC_SEED,
{% elif has_dc_nl %}            i_nl_prev: DC_NL_I,
            i_nl_prev_prev: DC_NL_I,
{% else %}            i_nl_prev: [0.0; M],
            i_nl_prev_prev: [0.0; M],
{% endif %}            dc_operating_point: DC_OP,
            damp_thresh: {{ damp_thresh_init }},
{% else %}            v_prev: {% if has_cap_ic %}V_PREV_IC_SEED{% else %}[0.0; N]{% endif %},
{% if has_dc_nl_ic_seed %}            i_nl_prev: DC_NL_I_IC_SEED,
            i_nl_prev_prev: DC_NL_I_IC_SEED,
{% elif has_dc_nl %}            i_nl_prev: DC_NL_I,
            i_nl_prev_prev: DC_NL_I,
{% else %}            i_nl_prev: [0.0; M],
            i_nl_prev_prev: [0.0; M],
{% endif %}            dc_operating_point: [0.0; N],
            damp_thresh: 2.0,
{% endif %}{% if multi_input %}            inputs_prev: [0.0; NUM_INPUTS],
{% else %}            input_prev: 0.0,
{% endif %}{% if inject_or_tap %}            injections_prev: [0.0; NUM_INJECT],
{% endif %}            last_nr_iterations: 0,
{% if dc_block %}            dc_block_x_prev: {% if has_dc_op or has_cap_ic %}dc_block_x_seed{% else %}[0.0; NUM_OUTPUTS]{% endif %},
            dc_block_y_prev: [0.0; NUM_OUTPUTS],
            dc_block_r: DC_BLOCK_R,
{% endif %}            diag_peak_output: 0.0,
            diag_clamp_count: 0,
            diag_nr_max_iter_count: 0,
            diag_nan_reset_count: 0,
            diag_magnitude_reset_count: 0,
            diag_singular_matrix_count: 0,
            diag_voltage_damp_count: 0,
            diag_substep_count: 0,
            s: S_DEFAULT,
            a_neg: A_NEG_DEFAULT,
            k: K_DEFAULT,
            s_ni: S_NI_DEFAULT,
{% if has_be_fallback %}
            s_be: S_BE_DEFAULT,
            k_be: K_BE_DEFAULT,
            s_ni_be: S_NI_BE_DEFAULT,
            a_neg_be: A_NEG_BE_DEFAULT,
            be_cooldown: 0,
{% endif %}
            diag_be_fallback_count: 0,
{% if num_inductors > 0 %}
            ind_i_prev: [0.0; {{ num_inductors }}],
            ind_v_prev: [0.0; {{ num_inductors }}],
            ind_i_hist: [0.0; {{ num_inductors }}],
            ind_g_eq: [{% for ind in inductors %}IND_{{ loop.index0 }}_G_EQ{% if not loop.last %}, {% endif %}{% endfor %}],
{% endif %}
{% if num_coupled_inductors > 0 %}
            ci_i1_prev: [0.0; {{ num_coupled_inductors }}],
            ci_i2_prev: [0.0; {{ num_coupled_inductors }}],
            ci_v1_prev: [0.0; {{ num_coupled_inductors }}],
            ci_v2_prev: [0.0; {{ num_coupled_inductors }}],
            ci_i1_hist: [0.0; {{ num_coupled_inductors }}],
            ci_i2_hist: [0.0; {{ num_coupled_inductors }}],
            ci_g_self_1: [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_SELF_1{% if not loop.last %}, {% endif %}{% endfor %}],
            ci_g_self_2: [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_SELF_2{% if not loop.last %}, {% endif %}{% endfor %}],
            ci_g_mutual: [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_MUTUAL{% if not loop.last %}, {% endif %}{% endfor %}],
{% endif %}
{% if num_transformer_groups > 0 %}
{% for g in transformer_groups %}
            xfmr_{{ g.index }}_y: XFMR_{{ g.index }}_Y_DEFAULT,
            xfmr_{{ g.index }}_i_prev: [0.0; {{ g.num_windings }}],
            xfmr_{{ g.index }}_v_prev: [0.0; {{ g.num_windings }}],
            xfmr_{{ g.index }}_i_hist: [0.0; {{ g.num_windings }}],
{% endfor %}
{% endif %}
{% for default in pot_defaults %}
            pot_{{ loop.index0 }}_resistance: {{ default }},
            pot_{{ loop.index0 }}_resistance_prev: {{ default }},
{% endfor %}
{% if oversampling_factor > 1 %}
            os_up_state: [0.0; {{ os_state_size }}],
            os_dn_state: [[0.0; {{ os_state_size }}]; NUM_OUTPUTS],
{% endif %}{% if oversampling_4x %}
            os_up_state_outer: [0.0; {{ os_state_size_outer }}],
            os_dn_state_outer: [[0.0; {{ os_state_size_outer }}]; NUM_OUTPUTS],
{% endif %}
{% if num_switches > 0 %}
{% for idx in switch_indices %}
            switch_{{ idx }}_position: 0,
{% endfor %}
{% endif %}
{% if needs_current_sr %}
            current_sample_rate: SAMPLE_RATE,
{% endif %}
{% if num_switches > 0 or num_pots > 0 %}
            matrices_dirty: false,
{% endif %}
{% if num_device_params > 0 %}
{% for dev in device_params %}{% for p in dev.params %}
            device_{{ dev.dev_num }}_{{ p.field_suffix }}: DEVICE_{{ dev.dev_num }}_{{ p.const_suffix }},
{% endfor %}{% endfor %}
{% endif %}
{% if num_thermal_devices > 0 %}
{% for td in thermal_devices %}
            device_{{ td.dev_num }}_tj: DEVICE_{{ td.dev_num }}_TAMB,
{% endfor %}
{% endif %}
{% if noise_enabled_emit %}{{ noise_default_fields }}{% endif %}{% if runtime_sources | length > 0 %}{% for rt in runtime_sources %}            {{ rt.field_name }}: 0.0,
{% endfor %}{% endif %}        }
    }
}

impl CircuitState {
    /// Reset to the factory state.
    ///
    /// "Factory state" means everything returns to what codegen baked in:
    /// the DC operating point, the baked nonlinear bias currents, and
    /// nominal pot/switch values — all restored together so they agree.
    /// A runtime-recomputed operating point (from `recompute_dc_op`) is
    /// intentionally discarded here; callers that want coherence at
    /// *jittered* pot/device values should call `recompute_dc_op()` (or
    /// `settle_dc_op()`) after applying them, not `reset()`.
    pub fn reset(&mut self) {
{% if has_dc_op %}        // Restore the baked DC OP so it agrees with the baked bias currents
        // and the nominal pot/switch values restored below (a recomputed OP
        // at moved pots paired with the baked bias would be incoherent).
        self.dc_operating_point = DC_OP;
        self.damp_thresh = {{ damp_thresh_init }};
{% else %}        self.dc_operating_point = [0.0; N];
        self.damp_thresh = 2.0;
{% endif %}        self.v_prev = {% if has_cap_ic %}V_PREV_IC_SEED{% else %}self.dc_operating_point{% endif %};
{% if has_dc_nl_ic_seed %}        self.i_nl_prev = DC_NL_I_IC_SEED;
        self.i_nl_prev_prev = DC_NL_I_IC_SEED;
{% elif has_dc_nl %}        self.i_nl_prev = DC_NL_I;
        self.i_nl_prev_prev = DC_NL_I;
{% else %}        self.i_nl_prev = [0.0; M];
        self.i_nl_prev_prev = [0.0; M];
{% endif %}{% if multi_input %}        self.inputs_prev = [0.0; NUM_INPUTS];
{% else %}        self.input_prev = 0.0;
{% endif %}{% if inject_or_tap %}        self.injections_prev = [0.0; NUM_INJECT];
{% endif %}        self.last_nr_iterations = 0;
{% if dc_block and has_cap_ic %}        // Seed the DC blocker's x[n-1] from the same t=0 state as v_prev (see
        // Default) so reset() doesn't re-inject the startup thump.
        for k in 0..NUM_OUTPUTS { self.dc_block_x_prev[k] = V_PREV_IC_SEED[OUTPUT_NODES[k]]; }
        self.dc_block_y_prev = [0.0; NUM_OUTPUTS];
{% elif dc_block %}        // Seed the DC blocker's x[n-1] from the output-node DC OP (see Default)
        // so reset() doesn't re-inject the startup thump.
        for k in 0..NUM_OUTPUTS { self.dc_block_x_prev[k] = self.dc_operating_point[OUTPUT_NODES[k]]; }
        self.dc_block_y_prev = [0.0; NUM_OUTPUTS];
{% endif %}        self.diag_peak_output = 0.0;
        self.diag_clamp_count = 0;
        self.diag_nr_max_iter_count = 0;
        self.diag_nan_reset_count = 0;
        self.diag_magnitude_reset_count = 0;
        self.diag_singular_matrix_count = 0;
        self.diag_voltage_damp_count = 0;
        self.diag_substep_count = 0;
        self.diag_be_fallback_count = 0;
{% if has_be_fallback %}
        self.be_cooldown = 0;
{% endif %}
{% if num_inductors > 0 %}
        self.ind_i_prev = [0.0; {{ num_inductors }}];
        self.ind_v_prev = [0.0; {{ num_inductors }}];
        self.ind_i_hist = [0.0; {{ num_inductors }}];
{% endif %}
{% if num_coupled_inductors > 0 %}
        self.ci_i1_prev = [0.0; {{ num_coupled_inductors }}];
        self.ci_i2_prev = [0.0; {{ num_coupled_inductors }}];
        self.ci_v1_prev = [0.0; {{ num_coupled_inductors }}];
        self.ci_v2_prev = [0.0; {{ num_coupled_inductors }}];
        self.ci_i1_hist = [0.0; {{ num_coupled_inductors }}];
        self.ci_i2_hist = [0.0; {{ num_coupled_inductors }}];
{% endif %}
{% if num_transformer_groups > 0 %}
{% for g in transformer_groups %}
        self.xfmr_{{ g.index }}_i_prev = [0.0; {{ g.num_windings }}];
        self.xfmr_{{ g.index }}_v_prev = [0.0; {{ g.num_windings }}];
        self.xfmr_{{ g.index }}_i_hist = [0.0; {{ g.num_windings }}];
{% endfor %}
{% endif %}
{% for default in pot_defaults %}
        self.pot_{{ loop.index0 }}_resistance = {{ default }};
        self.pot_{{ loop.index0 }}_resistance_prev = {{ default }};
{% endfor %}
{% if num_switches > 0 %}
{% for idx in switch_indices %}
        self.switch_{{ idx }}_position = 0;
{% endfor %}
{% endif %}
{% if num_switches > 0 or num_pots > 0 %}
        // Pots/switches were just restored to their defaults, but the live
        // S/K/A_neg matrices may still reflect the previous knob values.
        // Force a rebuild on the next process_sample so fields and matrices
        // agree. (Noise-coefficient defaults — thermal sqrt(1/R), resistor
        // flicker 1/R, op-amp en_g_diag — are restored to their baked
        // constants by the noise reset body below, which matches the
        // nominal pot values restored here.)
        self.matrices_dirty = true;
{% endif %}
{% if oversampling_factor > 1 %}
        self.os_up_state = [0.0; {{ os_state_size }}];
        self.os_dn_state = [[0.0; {{ os_state_size }}]; NUM_OUTPUTS];
{% endif %}{% if oversampling_4x %}
        self.os_up_state_outer = [0.0; {{ os_state_size_outer }}];
        self.os_dn_state_outer = [[0.0; {{ os_state_size_outer }}]; NUM_OUTPUTS];
{% endif %}
{% if num_device_params > 0 %}
{% for dev in device_params %}{% for p in dev.params %}
        self.device_{{ dev.dev_num }}_{{ p.field_suffix }} = DEVICE_{{ dev.dev_num }}_{{ p.const_suffix }};
{% endfor %}{% endfor %}
{% endif %}
{% if num_thermal_devices > 0 %}
{% for td in thermal_devices %}
        self.device_{{ td.dev_num }}_tj = DEVICE_{{ td.dev_num }}_TAMB;
{% endfor %}
{% endif %}
{% if noise_enabled_emit %}{{ noise_reset_body }}{% endif %}{% if runtime_sources | length > 0 %}{% for rt in runtime_sources %}        self.{{ rt.field_name }} = 0.0;
{% endfor %}{% endif %}
    }

    /// Set DC operating point (call after DC analysis)
    pub fn set_dc_operating_point(&mut self, v_dc: [f64; N]) {
        self.dc_operating_point = v_dc;
        self.v_prev = v_dc;
        self.refresh_damp_thresh();
    }

    /// Recompute the cached Step-6c damping threshold from the current DC
    /// operating point. Called wherever `dc_operating_point` is mutated so the
    /// per-sample safety net can read `self.damp_thresh` directly. Mirrors the
    /// former per-sample loop exactly (fold of |·| then `.mul_add(0.05, 2.0)`).
    #[inline]
    fn refresh_damp_thresh(&mut self) {
        let mut max_dc = 0.0_f64;
        for i in 0..{{ n_nodes }} {
            let a = self.dc_operating_point[i].abs();
            if a > max_dc { max_dc = a; }
        }
        self.damp_thresh = max_dc.mul_add(0.05, 2.0);
    }

    /// Read the baked DC operating point for this circuit.
    ///
    /// This is the solution to the nonlinear DC system computed at codegen
    /// time (at nominal pot/switch values) and frozen into the `DC_OP`
    /// constant. Prefer this over `v_prev` when you want the *designed*
    /// bias point — `v_prev` carries per-sample dynamics plus any updates
    /// from `set_dc_operating_point` / `recompute_dc_op`.
    ///
    /// For per-node access with readable names, see [`dc_op_dump`].
    #[inline]
    pub fn dc_op(&self) -> &[f64; N] {
        &self.dc_operating_point
    }
{% if emit_dc_op_recompute %}
    /// Re-solve the DC operating point at the current pot/switch values
    /// (Oomox plugin roadmap P6).
    ///
    /// Call once after applying per-instance pot/switch jitter (or a preset
    /// change) and before processing audio, to skip the
    /// `WARMUP_SAMPLES_RECOMMENDED` silence loop that would otherwise be
    /// needed for the solver to settle into the jittered equilibrium.
    ///
    /// **Not audio-thread safe.** The NR solve can take tens to hundreds of
    /// microseconds. Call from plugin initialization or parameter-change
    /// callbacks, not inside `process_sample`.
    ///
    /// # MVP limitations (Phase E)
    ///
    /// - Direct Newton-Raphson only; no source or Gmin stepping. If the NR
    ///   fails to converge (e.g. after a massive pot swing on a basin-trap
    ///   circuit), state is left unchanged and the caller should fall back
    ///   to the warmup loop.
    /// - No handling of multi-equilibrium precision-rectifier topologies.
    ///
    /// See `docs/aidocs/DC_OP.md` "Runtime DC OP recompute" for the full
    /// surface and semantic contract.
    pub fn recompute_dc_op(&mut self) {
{{ recompute_dc_op_body }}        // Cache refreshed on the converged fall-through path; the non-converged
        // branch returns early with dc_operating_point unchanged (cache stays
        // valid). Kept in sync with the Step-6c per-sample read.
        self.refresh_damp_thresh();
    }

    /// Settle to the DC operating point at current pot / switch / device
    /// values — the "recompute with warmup fallback" convenience wrapper.
    ///
    /// Calls [`recompute_dc_op`](CircuitState::recompute_dc_op) first;
    /// if the NR failed to update state (detected via
    /// `diag_nr_max_iter_count` advancing), falls back to
    /// `WARMUP_SAMPLES_RECOMMENDED` iterations of `process_sample(0.0, self)`.
    /// Always leaves the circuit at a valid equilibrium — either the exact
    /// NR solution or the warmup-loop-converged steady state.
    ///
    /// Plugin hosts should prefer this over calling `recompute_dc_op` and
    /// the warmup loop separately — the wrapper tracks the DK/nodal path
    /// distinction automatically (DK path normally succeeds; nodal path
    /// always falls back today because the runtime NR is deferred — see
    /// `recompute_dc_op` docs).
    ///
    /// **Not audio-thread safe.** Both stages are blocking. Call from
    /// plugin initialization or parameter-change callbacks.
    pub fn settle_dc_op(&mut self) {
{{ settle_dc_op_body }}    }
{% endif %}
{% if named_nodes | length > 0 %}
    /// Pretty-print the DC operating point with user-assigned node names.
    ///
    /// Writes one line per named node to `stderr` in the form
    /// `  V(node_name) = +X.XXX V`. Useful for sanity-checking circuit
    /// bias during plugin bring-up. Internal / augmented nodes (VS/VCVS
    /// branch currents, transformer windings) are not emitted — they have
    /// no stable user-facing name.
    ///
    /// Call order-of-magnitude-free: formatting allocates. Not meant for
    /// the audio thread.
    pub fn dc_op_dump(&self) {
        let dc = &self.dc_operating_point;
{% for entry in named_nodes %}        eprintln!("  V({{ entry.name }}) = {:+.4} V", dc[{{ entry.value }}]);
{% endfor %}    }
{% endif %}

    /// Recompute all sample-rate-dependent matrices for a new sample rate.
    ///
    /// Call this once during plugin initialization (NOT on the audio thread).
    /// This recomputes S, A_neg, K, S*N_i, and inductor g_eq from the stored
    /// G and C matrices.
    ///
    /// If `sample_rate` matches [`SAMPLE_RATE`], only the rate-dependent
    /// coefficients are restored to their baked defaults; transient state
    /// (filter and magnetics history) is preserved so a no-op rate call
    /// never clicks.
    pub fn set_sample_rate(&mut self, sample_rate: f64) {
        if !(sample_rate > 0.0 && sample_rate.is_finite()) {
            return; // Invalid sample rate, keep defaults
        }
{% if noise_enabled_emit %}{{ noise_set_sample_rate_body }}{% endif %}
{% if needs_current_sr %}        self.current_sample_rate = sample_rate;
{% endif %}
{% if num_switches > 0 or num_pots > 0 %}
        // Same-rate call: restore rate-dependent defaults where possible.
        if (sample_rate - SAMPLE_RATE).abs() < 0.5 {
            // The baked S/K/A_neg defaults were computed at nominal pot
            // resistances AND default switch positions, so BOTH must be at
            // default before loading them. Checking only switches would
            // silently revert a moved pot to nominal matrices — and the
            // pot setter's unchanged-value early-return would then lock
            // the stale matrices in until the next actual knob motion.
            let all_default = true
{% for idx in switch_indices %}                && self.switch_{{ idx }}_position == 0
{% endfor %}{% for default in pot_defaults %}                && (self.pot_{{ loop.index0 }}_resistance - {{ default }}).abs() < 1e-9
{% endfor %}            ;
            if all_default {
                self.s = S_DEFAULT;
                self.a_neg = A_NEG_DEFAULT;
                self.k = K_DEFAULT;
                self.s_ni = S_NI_DEFAULT;
{% if has_be_fallback %}
                self.s_be = S_BE_DEFAULT;
                self.k_be = K_BE_DEFAULT;
                self.s_ni_be = S_NI_BE_DEFAULT;
                self.a_neg_be = A_NEG_BE_DEFAULT;
{% endif %}
{% if num_inductors > 0 %}
                self.ind_g_eq = [{% for ind in inductors %}IND_{{ loop.index0 }}_G_EQ{% if not loop.last %}, {% endif %}{% endfor %}];
{% endif %}
{% if num_coupled_inductors > 0 %}
                self.ci_g_self_1 = [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_SELF_1{% if not loop.last %}, {% endif %}{% endfor %}];
                self.ci_g_self_2 = [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_SELF_2{% if not loop.last %}, {% endif %}{% endfor %}];
                self.ci_g_mutual = [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_MUTUAL{% if not loop.last %}, {% endif %}{% endfor %}];
{% endif %}
{% if num_transformer_groups > 0 %}
{% for g in transformer_groups %}
                self.xfmr_{{ g.index }}_y = XFMR_{{ g.index }}_Y_DEFAULT;
{% endfor %}
{% endif %}
{% if dc_block %}                self.dc_block_r = DC_BLOCK_R;
{% endif %}
                // POLICY: transient state — oversampler filter history,
                // inductor / coupled-inductor / transformer standing
                // currents, DC-blocker history — is PRESERVED here. Only
                // coefficients and matrices are restored: a same-rate call
                // is a no-op reconfiguration and must not click (mirrors
                // rebuild_matrices' standing-current rationale).
                return;
            }
            // Same rate but pots/switches are off-default: rebuild the
            // matrices at the live values. Rate-dependent coefficients
            // equal their baked defaults at this rate; transient state is
            // preserved (see POLICY above).
{% if dc_block %}            self.dc_block_r = DC_BLOCK_R;
{% endif %}            self.rebuild_matrices();
            return;
        }

        // Genuine sample-rate change: rebuild matrices at the new rate
        // (rebuild_matrices reads self.current_sample_rate, set above) and
        // recompute every rate-dependent coefficient. Filter state built at
        // the old rate is invalid at the new one, so the oversampler and DC
        // blocker are re-seeded here — same contract as the no-pot variant.
        self.rebuild_matrices();
{% if dc_block %}        let internal_rate = sample_rate * OVERSAMPLING_FACTOR as f64;
        self.dc_block_r = 1.0 - 2.0 * std::f64::consts::PI * 5.0 / internal_rate;
        for k in 0..NUM_OUTPUTS { self.dc_block_x_prev[k] = self.dc_operating_point[OUTPUT_NODES[k]]; }
        self.dc_block_y_prev = [0.0; NUM_OUTPUTS];
{% endif %}
{% if oversampling_factor > 1 %}        // Reset oversampler filter state (old state is incompatible with new rate)
        self.os_up_state = [0.0; {{ os_state_size }}];
        self.os_dn_state = [[0.0; {{ os_state_size }}]; NUM_OUTPUTS];
{% endif %}{% if oversampling_4x %}        self.os_up_state_outer = [0.0; {{ os_state_size_outer }}];
        self.os_dn_state_outer = [[0.0; {{ os_state_size_outer }}]; NUM_OUTPUTS];
{% endif %}
{% else %}

        // If same as codegen sample rate, restore rate-dependent defaults
        // (avoids numerical drift from repeated rebuilds).
        if (sample_rate - SAMPLE_RATE).abs() < 0.5 {
            self.s = S_DEFAULT;
            self.a_neg = A_NEG_DEFAULT;
            self.k = K_DEFAULT;
            self.s_ni = S_NI_DEFAULT;
{% if has_be_fallback %}
            self.s_be = S_BE_DEFAULT;
            self.k_be = K_BE_DEFAULT;
            self.s_ni_be = S_NI_BE_DEFAULT;
            self.a_neg_be = A_NEG_BE_DEFAULT;
{% endif %}
{% if num_inductors > 0 %}
            self.ind_g_eq = [{% for ind in inductors %}IND_{{ loop.index0 }}_G_EQ{% if not loop.last %}, {% endif %}{% endfor %}];
{% endif %}
{% if num_coupled_inductors > 0 %}
            self.ci_g_self_1 = [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_SELF_1{% if not loop.last %}, {% endif %}{% endfor %}];
            self.ci_g_self_2 = [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_SELF_2{% if not loop.last %}, {% endif %}{% endfor %}];
            self.ci_g_mutual = [{% for ci in coupled_inductors %}CI_{{ loop.index0 }}_G_MUTUAL{% if not loop.last %}, {% endif %}{% endfor %}];
{% endif %}
{% if num_transformer_groups > 0 %}
{% for g in transformer_groups %}
            self.xfmr_{{ g.index }}_y = XFMR_{{ g.index }}_Y_DEFAULT;
{% endfor %}
{% endif %}
{% if dc_block %}            self.dc_block_r = DC_BLOCK_R;
{% endif %}
            // POLICY: transient state — oversampler filter history,
            // inductor / coupled-inductor / transformer standing currents,
            // DC-blocker history — is PRESERVED here. Only coefficients and
            // matrices are restored: a same-rate call is a no-op
            // reconfiguration and must not click (same standing-current
            // rationale as the pot-variant early-out and the rebuild path).
            return;
        }

        let internal_rate = sample_rate * OVERSAMPLING_FACTOR as f64;
{% if backward_euler %}        let alpha = internal_rate;
{% else %}        let alpha = 2.0 * internal_rate;
{% endif %}
{% if num_inductors > 0 or num_coupled_inductors > 0 or num_transformer_groups > 0 %}        let t = 1.0 / internal_rate;
{% endif %}
        // Build A = G + alpha*C
        let mut a = [[0.0f64; N]; N];
        for i in 0..N {
            for j in 0..N {
                a[i][j] = G[i][j] + alpha * C[i][j];
            }
        }

{% if backward_euler %}        // Build A_neg = alpha*C (backward Euler: no -G term)
        let mut a_neg = [[0.0f64; N]; N];
        for i in 0..N {
            for j in 0..N {
                a_neg[i][j] = alpha * C[i][j];
            }
        }
{% else %}        // Build A_neg = alpha*C - G (trapezoidal)
        let mut a_neg = [[0.0f64; N]; N];
        for i in 0..N {
            for j in 0..N {
                a_neg[i][j] = alpha * C[i][j] - G[i][j];
            }
        }
{% endif %}
{% if has_augmented %}
        // Zero VS/VCVS algebraic rows in A_neg (NOT inductor rows).
        // These have no capacitance and no history — rhs_const provides V_dc directly.
{% if augmented_inductors %}
        for i in {{ n_nodes }}..{{ n_aug }} {
{% else %}
        for i in {{ n_nodes }}..N {
{% endif %}
            for j in 0..N {
                a_neg[i][j] = 0.0;
            }
        }
{% endif %}
{% if num_inductors > 0 %}

        // Add inductor companion model conductances
{% for ind in inductors %}        {
            let g_eq = t / (2.0 * IND_{{ loop.index0 }}_INDUCTANCE);
            self.ind_g_eq[{{ loop.index0 }}] = g_eq;
            stamp_conductance(&mut a, IND_{{ loop.index0 }}_NODE_I, IND_{{ loop.index0 }}_NODE_J, g_eq);
            stamp_conductance(&mut a_neg, IND_{{ loop.index0 }}_NODE_I, IND_{{ loop.index0 }}_NODE_J, -g_eq);
        }
{% endfor %}
        // Reset inductor transient state (old g_eq is incompatible with new rate)
        self.ind_i_prev = [0.0; {{ num_inductors }}];
        self.ind_v_prev = [0.0; {{ num_inductors }}];
        self.ind_i_hist = [0.0; {{ num_inductors }}];
{% endif %}
{% if num_coupled_inductors > 0 %}

        // Add coupled inductor companion model conductances
{% for ci in coupled_inductors %}        {
            let m_val = CI_{{ loop.index0 }}_COUPLING * (CI_{{ loop.index0 }}_L1_INDUCTANCE * CI_{{ loop.index0 }}_L2_INDUCTANCE).sqrt();
            let det = CI_{{ loop.index0 }}_L1_INDUCTANCE * CI_{{ loop.index0 }}_L2_INDUCTANCE - m_val * m_val;
            let half_t = t / 2.0;
            let gs1 = half_t * CI_{{ loop.index0 }}_L2_INDUCTANCE / det;
            let gs2 = half_t * CI_{{ loop.index0 }}_L1_INDUCTANCE / det;
            let gm = -half_t * m_val / det;
            self.ci_g_self_1[{{ loop.index0 }}] = gs1;
            self.ci_g_self_2[{{ loop.index0 }}] = gs2;
            self.ci_g_mutual[{{ loop.index0 }}] = gm;
            stamp_conductance(&mut a, CI_{{ loop.index0 }}_L1_NODE_I, CI_{{ loop.index0 }}_L1_NODE_J, gs1);
            stamp_conductance(&mut a_neg, CI_{{ loop.index0 }}_L1_NODE_I, CI_{{ loop.index0 }}_L1_NODE_J, -gs1);
            stamp_conductance(&mut a, CI_{{ loop.index0 }}_L2_NODE_I, CI_{{ loop.index0 }}_L2_NODE_J, gs2);
            stamp_conductance(&mut a_neg, CI_{{ loop.index0 }}_L2_NODE_I, CI_{{ loop.index0 }}_L2_NODE_J, -gs2);
            stamp_mutual(&mut a, CI_{{ loop.index0 }}_L1_NODE_I, CI_{{ loop.index0 }}_L1_NODE_J, CI_{{ loop.index0 }}_L2_NODE_I, CI_{{ loop.index0 }}_L2_NODE_J, gm);
            stamp_mutual(&mut a, CI_{{ loop.index0 }}_L2_NODE_I, CI_{{ loop.index0 }}_L2_NODE_J, CI_{{ loop.index0 }}_L1_NODE_I, CI_{{ loop.index0 }}_L1_NODE_J, gm);
            stamp_mutual(&mut a_neg, CI_{{ loop.index0 }}_L1_NODE_I, CI_{{ loop.index0 }}_L1_NODE_J, CI_{{ loop.index0 }}_L2_NODE_I, CI_{{ loop.index0 }}_L2_NODE_J, -gm);
            stamp_mutual(&mut a_neg, CI_{{ loop.index0 }}_L2_NODE_I, CI_{{ loop.index0 }}_L2_NODE_J, CI_{{ loop.index0 }}_L1_NODE_I, CI_{{ loop.index0 }}_L1_NODE_J, -gm);
        }
{% endfor %}
        // Reset coupled inductor transient state
        self.ci_i1_prev = [0.0; {{ num_coupled_inductors }}];
        self.ci_i2_prev = [0.0; {{ num_coupled_inductors }}];
        self.ci_v1_prev = [0.0; {{ num_coupled_inductors }}];
        self.ci_v2_prev = [0.0; {{ num_coupled_inductors }}];
        self.ci_i1_hist = [0.0; {{ num_coupled_inductors }}];
        self.ci_i2_hist = [0.0; {{ num_coupled_inductors }}];
{% endif %}
{% if num_transformer_groups > 0 %}

        // Add transformer group companion model conductances
{{ xfmr_set_sample_rate_lines }}{% endif %}

        // Invert A to get S (equilibrated to keep cond(A) inside f64 precision
        // regardless of unit imbalance between G_in and internal conductances)
        let (s, singular) = invert_n_equilibrated(a);
        if singular {
            self.diag_singular_matrix_count += 1;
        }

        // Compute S * N_i product (N x M)
        let mut s_ni = [[0.0f64; M]; N];
        for i in 0..N {
            for j in 0..M {
                let mut sum = 0.0;
                for kk in 0..N {
                    sum += s[i][kk] * N_I[j][kk]; // N_I is transposed: [M][N]
                }
                s_ni[i][j] = sum;
            }
        }

        // Compute K = N_v * S_NI (M x M)
        let mut k = [[0.0f64; M]; M];
        for i in 0..M {
            for j in 0..M {
                let mut sum = 0.0;
                for n_idx in 0..N {
                    sum += N_V[i][n_idx] * s_ni[n_idx][j];
                }
                k[i][j] = sum;
            }
        }{{ k_eff_adjust_lines }}

        self.s = s;
        self.a_neg = a_neg;
        self.k = k;
        self.s_ni = s_ni;
{% if has_be_fallback %}

        // Recompute backward Euler fallback matrices
        let alpha_be = internal_rate; // 1/T for backward Euler
        let mut a_be = [[0.0f64; N]; N];
        for i in 0..N {
            for j in 0..N {
                a_be[i][j] = G[i][j] + alpha_be * C[i][j];
            }
        }
        let mut a_neg_be = [[0.0f64; N]; N];
        for i in 0..N {
            for j in 0..N {
                a_neg_be[i][j] = alpha_be * C[i][j];
            }
        }
{% if has_augmented %}
{% if augmented_inductors %}
        for i in {{ n_nodes }}..{{ n_aug }} {
{% else %}
        for i in {{ n_nodes }}..N {
{% endif %}
            for j in 0..N {
                a_neg_be[i][j] = 0.0;
            }
        }
{% endif %}
        let (s_be, singular_be) = invert_n_equilibrated(a_be);
        if singular_be {
            self.diag_singular_matrix_count += 1;
        }
        let mut s_ni_be = [[0.0f64; M]; N];
        for i in 0..N {
            for j in 0..M {
                let mut sum = 0.0;
                for kk in 0..N {
                    sum += s_be[i][kk] * N_I[j][kk];
                }
                s_ni_be[i][j] = sum;
            }
        }
        let mut k_be = [[0.0f64; M]; M];
        for i in 0..M {
            for j in 0..M {
                let mut sum = 0.0;
                for n_idx in 0..N {
                    sum += N_V[i][n_idx] * s_ni_be[n_idx][j];
                }
                k_be[i][j] = sum;
            }
        }{{ k_be_eff_adjust_lines }}
        self.s_be = s_be;
        self.k_be = k_be;
        self.s_ni_be = s_ni_be;
        self.a_neg_be = a_neg_be;
{% endif %}
{# SM vectors removed — per-block rebuild handles pot corrections exactly #}
{% if oversampling_factor > 1 %}
        // Reset oversampler filter state (old state is incompatible with new rate)
        self.os_up_state = [0.0; {{ os_state_size }}];
        self.os_dn_state = [[0.0; {{ os_state_size }}]; NUM_OUTPUTS];
{% endif %}{% if oversampling_4x %}
        self.os_up_state_outer = [0.0; {{ os_state_size_outer }}];
        self.os_dn_state_outer = [[0.0; {{ os_state_size_outer }}]; NUM_OUTPUTS];
{% endif %}

        // Recompute DC blocking coefficient for new sample rate
        {% if oversampling_factor > 1 %}
        let internal_rate = sample_rate * {{ oversampling_factor }}.0;
        {% else %}
        let internal_rate = sample_rate;
        {% endif %}
{% if dc_block %}        self.dc_block_r = 1.0 - 2.0 * std::f64::consts::PI * 5.0 / internal_rate;
        for k in 0..NUM_OUTPUTS { self.dc_block_x_prev[k] = self.dc_operating_point[OUTPUT_NODES[k]]; }
        self.dc_block_y_prev = [0.0; NUM_OUTPUTS];
{% endif %}
{% endif %}
    }
{% if num_switches > 0 or num_pots > 0 %}
{{ switch_methods }}
{% endif %}
{% if noise_enabled_emit %}{{ noise_methods }}
{% endif %}
}

{% if num_inductors > 0 or num_switches > 0 or num_coupled_inductors > 0 or num_transformer_groups > 0 %}/// Stamp a conductance between two nodes into a matrix.
/// Node indices are 1-indexed; 0 means ground.
fn stamp_conductance(mat: &mut [[f64; N]; N], node_i: usize, node_j: usize, g: f64) {
    match (node_i > 0, node_j > 0) {
        (true, true) => {
            let i = node_i - 1;
            let j = node_j - 1;
            mat[i][i] += g;
            mat[j][j] += g;
            mat[i][j] -= g;
            mat[j][i] -= g;
        }
        (true, false) => { mat[node_i - 1][node_i - 1] += g; }
        (false, true) => { mat[node_j - 1][node_j - 1] += g; }
        (false, false) => {}
    }
}

{% endif %}{% if num_coupled_inductors > 0 or num_transformer_groups > 0 %}/// Stamp mutual conductance between two 2-terminal elements.
fn stamp_mutual(mat: &mut [[f64; N]; N], a: usize, b: usize, c: usize, d: usize, g: f64) {
    if a > 0 && c > 0 { mat[a - 1][c - 1] += g; }
    if b > 0 && d > 0 { mat[b - 1][d - 1] += g; }
    if a > 0 && d > 0 { mat[a - 1][d - 1] -= g; }
    if b > 0 && c > 0 { mat[b - 1][c - 1] -= g; }
}

{% endif %}/// Invert an N x N matrix via LU factorization + N identity-column back-solves.
///
/// Returns `(result, singular)` where `singular` is `true` if the matrix was
/// detected as singular (pivot below threshold). On singularity, the identity
/// matrix is returned as a safe fallback; the caller should record the event
/// via `diag_singular_matrix_count`.
///
/// Previously used in-place Gauss-Jordan on an augmented `[A | I]` matrix
/// (N × 2N, ~2N³ ops, ~28 KB stack at N = 42). The LU path factors `A = LU`
/// in place (N × N, ~N³/3 ops) and solves `N` back-substitutions
/// (~N³ total), reducing work and stack use while producing identical
/// mathematical output for well-conditioned inputs. Singular-pivot behavior
/// matches the prior implementation byte-for-byte (same 1e-30 threshold,
/// same identity fallback).
fn invert_n(a: [[f64; N]; N]) -> ([[f64; N]; N], bool) {
    // --- 1. LU factorization in place with partial pivoting ---
    //
    // After this loop, `lu` holds L (below diagonal, unit-lower-triangular
    // with implicit 1s) and U (diagonal + above). `perm[i]` is the index
    // of the original row that ended up at row i of LU after pivoting —
    // equivalent to P·A = L·U.
    let mut lu = a;
    let mut perm = [0usize; N];
    for i in 0..N { perm[i] = i; }

    for k in 0..N {
        // Partial pivoting: find the largest |lu[i][k]| for i >= k.
        let mut max_row = k;
        let mut max_val = lu[k][k].abs();
        for i in (k + 1)..N {
            let v = lu[i][k].abs();
            if v > max_val { max_val = v; max_row = i; }
        }

        if max_val < 1e-30 {
            let mut result = [[0.0f64; N]; N];
            for i in 0..N { result[i][i] = 1.0; }
            return (result, true);
        }

        if max_row != k {
            lu.swap(k, max_row);
            perm.swap(k, max_row);
        }

        // Eliminate column k below the pivot.
        let pivot = lu[k][k];
        for i in (k + 1)..N {
            let m = lu[i][k] / pivot;
            lu[i][k] = m;
            for j in (k + 1)..N {
                lu[i][j] -= m * lu[k][j];
            }
        }
    }

    // --- 2. Solve `A · result[:, col] = e_col` for each identity column ---
    //
    // Equivalent to `L · U · x = P · e_col`. Each back-solve is O(N²), and
    // `P · e_col` has exactly one nonzero (at the row `i` where
    // `perm[i] == col`), so forward substitution can skip the leading zeros.
    let mut result = [[0.0f64; N]; N];
    for col in 0..N {
        // b ← P · e_col
        let mut b = [0.0f64; N];
        let mut start = N;
        for i in 0..N {
            if perm[i] == col {
                b[i] = 1.0;
                start = i;
                break;
            }
        }

        // Forward substitution: L · y = b. L's diagonal is implicit 1.0.
        // Skip rows before the nonzero since they contribute nothing.
        for i in (start + 1)..N {
            let mut sum = b[i];
            for j in start..i {
                sum -= lu[i][j] * b[j];
            }
            b[i] = sum;
        }

        // Backward substitution: U · x = y. U is stored on + above diagonal.
        for i in (0..N).rev() {
            let mut sum = b[i];
            for j in (i + 1)..N {
                sum -= lu[i][j] * b[j];
            }
            let pivot = lu[i][i];
            if pivot.abs() < 1e-30 {
                // Diagonal became singular during elimination (ill-conditioned
                // input that passed the column-pivot check but collapses here).
                let mut fallback = [[0.0f64; N]; N];
                for k in 0..N { fallback[k][k] = 1.0; }
                return (fallback, true);
            }
            b[i] = sum / pivot;
        }

        for i in 0..N {
            result[i][col] = b[i];
        }
    }

    (result, false)
}

/// Equilibrated inverse: same as [`invert_n`] but pre-applies asymmetric
/// row/column scaling so partial-pivoting LU sees a max-norm-balanced matrix.
///
/// Without this, melange's input row (`G_in = 1 S` Thevenin source) dominates
/// the MNA G matrix by 4-6 decades over typical neighbouring conductances
/// (1e-4 to 1e-6 S), bounding `cond(A)` below by ~1e6 and losing ~6 digits
/// of f64 precision before solving.
///
/// Algorithm: scale `A_eq[i][j] = dr[i] * a[i][j] * dc[j]` with
/// `dr[i] = 1/max_j|a[i][j]|` and `dc[j] = 1/max_i|A_eq[i][j]|`. Invert the
/// equilibrated matrix; recover `A^-1[i][j] = dc[i] * A_eq^-1[i][j] * dr[j]`.
///
/// Keep in sync with the nodal-emitter `lu_factor` equilibration in
/// `crates/melange-solver/src/codegen/rust_emitter/nodal_emitter.rs` and the
/// DC-OP `equilibrate` helper in `crates/melange-solver/src/dc_op.rs`.
fn invert_n_equilibrated(a: [[f64; N]; N]) -> ([[f64; N]; N], bool) {
    let mut a_eq = a;
    let mut dr = [1.0f64; N];
    let mut dc = [1.0f64; N];

    for i in 0..N {
        let mut row_max = 0.0f64;
        for j in 0..N {
            let v = a_eq[i][j].abs();
            if v > row_max { row_max = v; }
        }
        dr[i] = if row_max > 1e-30 { 1.0 / row_max } else { 1.0 };
    }
    for i in 0..N {
        for j in 0..N { a_eq[i][j] *= dr[i]; }
    }

    for j in 0..N {
        let mut col_max = 0.0f64;
        for i in 0..N {
            let v = a_eq[i][j].abs();
            if v > col_max { col_max = v; }
        }
        dc[j] = if col_max > 1e-30 { 1.0 / col_max } else { 1.0 };
    }
    for i in 0..N {
        for j in 0..N { a_eq[i][j] *= dc[j]; }
    }

    let (e_inv, singular) = invert_n(a_eq);
    if singular {
        return (e_inv, true);
    }

    // A^-1[i][j] = dc[i] * E^-1[i][j] * dr[j]
    let mut result = [[0.0f64; N]; N];
    for i in 0..N {
        for j in 0..N {
            result[i][j] = dc[i] * e_inv[i][j] * dr[j];
        }
    }
    (result, false)
}

