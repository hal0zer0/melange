/// Compute final node voltages: v = v_pred + state.s_ni * i_nl
///
/// Uses the full i_nl at n+1 (not a delta): under the charge form the
/// nonlinear current enters the step at n+1 only, and the capacitor history
/// (alpha*C*v_prev + q_dot) is carried by the RHS.
///
/// The S*N_i product is stored in state.s_ni for sample rate independence.
#[inline(always)]
fn compute_final_voltages(
    v_pred: &[f64; N],
    i_nl: &[f64; M],
    state: &CircuitState,
) -> [f64; N] {
    let mut v = *v_pred;
    for i in 0..N {
        for j in 0..M {
            v[i] += state.s_ni[i][j] * i_nl[j];
        }
    }
    v
}

