#![allow(clippy::excessive_precision)]
#![allow(clippy::needless_range_loop)]
#![allow(clippy::too_many_arguments)]
// NaN-honest convergence predicates are deliberately written as !(a < b) so a
// NaN iterate reads as not-converged — do not "simplify" them back.
#![allow(clippy::neg_cmp_op_on_partial_ord)]
#![allow(clippy::nonminimal_bool)]
#![allow(unexpected_cfgs)]
#![allow(dead_code)]
// `.runtime R <name> as <field>` emits `set_runtime_R_<field>` (capital R), and
// other directive-derived identifiers may not be snake_case. Generated code is
// not hand-edited, so silence the lint to keep downstream `clippy -D warnings`
// green.
#![allow(non_snake_case)]
// Generated code trips these too: `eq_op` on algebraically-identical operands
// that differ in intent; `reversed_empty_ranges` on loop bounds computed from
// topology that can legitimately be empty; `large_const_arrays` on big const
// matrices; `unused_variables` structurally on M=0 decks where the nonlinear
// solve path is emitted but dead. Emitting the allows here keeps them
// self-maintaining across regeneration (an externally-added attribute rots).
#![allow(clippy::eq_op)]
#![allow(clippy::reversed_empty_ranges)]
#![allow(clippy::large_const_arrays)]
#![allow(unused_variables)]

