#![allow(clippy::excessive_precision)]
// A baked constant can land on a well-known value by arithmetic alone (a
// thermal-noise scale `sqrt(1/R)` at R = 0.5 Ω is √2 to the last digit), and
// `approx_constant` is deny-by-default, so without this an untouched
// generated file fails `cargo clippy` outright.
#![allow(clippy::approx_constant)]
// The sub-sample-fire schedule tests `t % (h << 1) == 0`; clippy 1.99 wants
// `is_multiple_of`, which needs Rust 1.87 while this code must build on the
// 1.85 MSRV.
#![allow(clippy::manual_is_multiple_of)]
// Matrix coefficients are emitted as literals, so an entry that is exactly −1
// reads as `x * -1.0e0`; it is a value, not a style choice.
#![allow(clippy::neg_multiply)]
// Behavioral-source expressions are emitted as fully parenthesised trees, and
// their `max(min(x, hi), lo)` is deliberate: `f64::clamp` panics when
// `lo > hi` and treats NaN differently, so it is not a drop-in replacement.
#![allow(clippy::double_parens)]
#![allow(clippy::manual_clamp)]
// Topology-dependent control flow assigns a `let v;` in whichever branches
// the deck has.
#![allow(clippy::needless_late_init)]
#![allow(clippy::needless_range_loop)]
#![allow(clippy::too_many_arguments)]
// NaN-honest convergence predicates are deliberately written as !(a < b) so a
// NaN iterate reads as not-converged — do not "simplify" them back.
#![allow(clippy::neg_cmp_op_on_partial_ord)]
#![allow(clippy::nonminimal_bool)]
#![allow(unexpected_cfgs)]
#![allow(dead_code)]
// `.runtime R <name> as <field>` emits `set_runtime_R_<field>` (capital R), and
// other directive-derived identifiers may not be snake_case. Generated code is
// not hand-edited, so silence the lint to keep downstream `clippy -D warnings`
// green.
#![allow(non_snake_case)]
// Generated code trips these too: `eq_op` on algebraically-identical operands
// that differ in intent; `reversed_empty_ranges` on loop bounds computed from
// topology that can legitimately be empty; `large_const_arrays` on big const
// matrices; `unused_variables` structurally on M=0 decks where the nonlinear
// solve path is emitted but dead. Emitting the allows here keeps them
// self-maintaining across regeneration (an externally-added attribute rots).
#![allow(clippy::eq_op)]
#![allow(clippy::reversed_empty_ranges)]
#![allow(clippy::large_const_arrays)]
#![allow(unused_variables)]
// Multi-device decks also trip these:
// `unused_mut` on emitter-declared scratch arrays only some device mix writes to
// (e.g. nan_taps); `manual_memcpy` on index-copy loops the emitter produces.
// Same self-maintaining rationale — an externally-added attribute rots.
#![allow(unused_mut)]
#![allow(clippy::manual_memcpy)]

